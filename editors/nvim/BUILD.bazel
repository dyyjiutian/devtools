load("//tests/common/rules:devtools_tests.bzl", "devtools_module_tests")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "nvim_srcs",
    srcs = [
        "setup.sh",
        "init.lua",
        "README.md",
        "lua/plugins/lsp.lua",
        "lua/plugins/telescope.lua",
        "lua/plugins/treesitter.lua",
    ],
)

exports_files([
    "setup.sh",
    "tests/nvim_suite.sh",
])

devtools_module_tests(
    name = "nvim",
    suite = ":tests/nvim_suite.sh",
    module_root = ":setup.sh",
    module_data = [":nvim_srcs"],
    profiles = [
        "linux_ubuntu",
        "linux_alinux3",
        "linux_alinux4",
        "macos",
    ],
    docker_profiles = [
        "linux_ubuntu",
    ],
)
