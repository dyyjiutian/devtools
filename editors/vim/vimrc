" ============================================================
" Vim Configuration
" Plugin Manager: vim-plug (auto-install)
" ============================================================

" --- Auto-install vim-plug ---
let data_dir = has('nvim') ? stdpath('data') . '/site' : '~/.vim'
if empty(glob(data_dir . '/autoload/plug.vim'))
  silent execute '!curl -fLo '.data_dir.'/autoload/plug.vim --create-dirs
    \ https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
  autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
endif

" --- coc.nvim prerequisites ---
" coc release 需要 Node >= 22.15.0。旧 Node 下 coc 启动即崩（Current Node.js
" version ... < 22.15.0），并且会卡住 Vim 退出，所以这里先判定再决定是否加载。
let s:node_ok = 0
if executable('node')
  let s:node_ver = matchlist(system('node -v'), 'v\(\d\+\)\.\(\d\+\)')
  if !empty(s:node_ver) && (str2nr(s:node_ver[1]) > 22 ||
        \ (str2nr(s:node_ver[1]) == 22 && str2nr(s:node_ver[2]) >= 15))
    let s:node_ok = 1
  endif
endif
let g:coc_enabled = (has('nvim') || has('patch-8.1.1719')) && s:node_ok

" --- Plugins ---
call plug#begin('~/.vim/plugged')

" File tree
Plug 'preservim/nerdtree'
Plug 'ryanoasis/vim-devicons'

" Git
Plug 'tpope/vim-fugitive'
Plug 'airblade/vim-gitgutter'

" Auto-completion (requires Vim 8.1.1719+ / Neovim 0.4.0+ AND Node >= 22.15)
if g:coc_enabled
  Plug 'neoclide/coc.nvim', {'branch': 'release'}
else
  " Fallback: simpler completion for older Vim or too-old Node
  Plug 'vim-scripts/AutoComplPop'
endif

" AI inline completion (ghost text, Tab to accept — like Cursor)
" Option A: GitHub Copilot (requires subscription + :Copilot setup)
Plug 'github/copilot.vim'
" Option B: Codeium (free alternative, requires :Codeium Auth)
" Plug 'Exafunction/codeium.vim'

" Syntax highlighting
Plug 'sheerun/vim-polyglot'

" Tag-based navigation (function jump)
Plug 'preservim/tagbar'
Plug 'ludovicchabant/vim-gutentags'

" Fuzzy finder
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim'

" Status line
Plug 'vim-airline/vim-airline'
Plug 'vim-airline/vim-airline-themes'

" Color scheme
Plug 'morhetz/gruvbox'

" Auto pairs
Plug 'jiangmiao/auto-pairs'

" Comment toggle
Plug 'tpope/vim-commentary'

" OSC52 clipboard for Linux (SSH remote → local clipboard)
if has('unix') && !has('macunix')
  Plug 'ojroques/vim-oscyank', {'branch': 'main'}
endif

call plug#end()

" ============================================================
" General Settings
" ============================================================
set nocompatible
filetype plugin indent on
syntax on

set encoding=utf-8
set fileencodings=utf-8,gbk,gb2312,gb18030,latin1
set fileformats=unix,dos
set history=1000
set viminfo='100,<50,s10,h  " 跨会话保存寄存器/marks/命令历史
set display=truncate       " 长行被截断时末行显示 @@@ 提示
set number
set relativenumber
set cursorline
set showcmd
set showmode
set autoread
set wildmenu
set wildmode=longest:full,full
set laststatus=2
set scrolloff=5
set sidescrolloff=5
set signcolumn=yes

" 光标移动顺滑：行首/行尾可跨行，翻页保持当前列
set whichwrap+=<,>,h,l,[,],b,s
set nostartofline

" 显示不可见字符：tab 与行尾空格
set list
set listchars=tab:»·,trail:·

" set clipboard=unnamed,unnamedplus  " disabled: d/c/y would overwrite system clipboard
" Use "+y to copy to clipboard, "+p to paste from clipboard
" 系统剪贴板便捷映射见下方 mapleader 定义之后的 ,y / ,p

" 注意：不要使用 set paste，它会禁用代码补全等自动功能
" 使用 F2 键临时切换粘贴模式

" Search
set hlsearch
set incsearch
set ignorecase
set smartcase

" Indent
set autoindent
set smartindent
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab

" Performance
set updatetime=300
set timeoutlen=1000
set ttimeout        " 为按键码启用超时
set ttimeoutlen=100 " Esc 后最多等 100ms，避免退出插入模式卡顿
set hidden
set nobackup
set nowritebackup
set noswapfile

" 持久化撤销：关闭后重开仍可 u 撤销历史
set undofile
set undodir=~/.vim/undo
if !isdirectory(expand('~/.vim/undo'))
  silent! call mkdir(expand('~/.vim/undo'), 'p', 0700)
endif

" 重新打开文件时，恢复到上次退出时的光标位置
augroup restore_cursor_position
  autocmd!
  autocmd BufReadPost * if &buftype ==# '' && index(['gitcommit', 'gitrebase'], &filetype) < 0 && line("'\"") > 0 && line("'\"") <= line('$') | execute 'normal! g`"' | endif
augroup END

" Mouse
" set mouse=c

" Cursor shape
let &t_SI = "\e[6 q"   " Insert mode: vertical bar
let &t_SR = "\e[4 q"   " Replace mode: underline
let &t_EI = "\e[2 q"   " Normal mode: block

" Backspace
set backspace=indent,eol,start

" Paste mode - disable auto-indent when pasting
set pastetoggle=<F2>

" Split
set splitbelow
set splitright

" ============================================================
" Color Scheme
" ============================================================
set termguicolors
set background=dark
silent! colorscheme gruvbox

" ============================================================
" Key Mappings
" ============================================================
let mapleader = ","

" NERDTree
nnoremap <Leader>n :NERDTreeToggle<CR>
nnoremap <Leader>f :NERDTreeFind<CR>

" Tagbar
nnoremap <Leader>t :TagbarToggle<CR>

" FZF
nnoremap <Leader>p :Files<CR>
nnoremap <Leader>g :Rg<CR>
nnoremap <Leader>b :Buffers<CR>

" Git (fugitive)
nnoremap <Leader>gs :Git<CR>
nnoremap <Leader>gd :Gdiffsplit<CR>
nnoremap <Leader>gb :Git blame<CR>
nnoremap <Leader>gl :Git log --oneline<CR>

" Window navigation
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Buffer navigation
nnoremap <Leader>bn :bnext<CR>
nnoremap <Leader>bp :bprevious<CR>
nnoremap <Leader>bd :bdelete<CR>

" Clear search highlight
nnoremap <Leader><Space> :nohlsearch<CR>

" Quick save / quit
nnoremap <Leader>w :w<CR>
nnoremap <Leader>q :q<CR>

" System clipboard (y/p 仍只用 vim 寄存器；,y/,P 走系统剪贴板)
" Linux/SSH: OSC52 via vim-oscyank；macOS: "+ 寄存器
if has('unix') && !has('macunix')
  nmap <Leader>y <Plug>OSCYankOperator
  nmap <Leader>Y <Leader>y$
  vmap <Leader>y <Plug>OSCYankVisual
else
  vnoremap <Leader>y "+y
  nnoremap <Leader>y "+y
  nnoremap <Leader>Y "+yg_
endif
vnoremap <Leader>P "+p
nnoremap <Leader>P "+p

" ============================================================
" NERDTree Settings
" ============================================================
let g:NERDTreeShowHidden = 1
let g:NERDTreeIgnore = ['\.pyc$', '__pycache__', '\.git$', 'node_modules']
let g:NERDTreeWinSize = 30
" Auto close vim if NERDTree is the only window
autocmd BufEnter * if winnr('$') == 1 && exists('b:NERDTree') && b:NERDTree.isTabTree() | quit | endif

" Accept next word of Copilot suggestion (partial accept).
" Pure Copilot: keep it even when coc is disabled (old Vim or old Node).
imap <C-]> <Plug>(copilot-accept-word)

" ============================================================
" coc.nvim Settings (Auto-completion & LSP)
" ============================================================
if g:coc_enabled
" Tab: Copilot suggestion → coc popup → normal Tab
" Copilot manages its own Tab map when g:copilot_no_tab_map = v:true
let g:copilot_no_tab_map = v:true
inoremap <silent><expr> <TAB>
      \ exists('*copilot#Accept') && copilot#GetDisplayedSuggestion().text != '' ? copilot#Accept('') :
      \ coc#pum#visible() ? coc#pum#next(1) :
      \ CheckBackspace() ? "\<Tab>" :
      \ coc#refresh()
inoremap <expr><S-TAB> coc#pum#visible() ? coc#pum#prev(1) : "\<C-h>"

" Enter to confirm completion
inoremap <silent><expr> <CR> coc#pum#visible() ? coc#pum#confirm()
                              \: "\<C-g>u\<CR>\<c-r>=coc#on_enter()\<CR>"

function! CheckBackspace() abort
  let col = col('.') - 1
  return !col || getline('.')[col - 1]  =~# '\s'
endfunction

" GoTo code navigation
nmap <silent> gd <Plug>(coc-definition)
nmap <silent> gy <Plug>(coc-type-definition)
nmap <silent> gi <Plug>(coc-implementation)
nmap <silent> gr <Plug>(coc-references)

" Show documentation
nnoremap <silent> K :call ShowDocumentation()<CR>
function! ShowDocumentation()
  if CocAction('hasProvider', 'hover')
    call CocActionAsync('doHover')
  else
    call feedkeys('K', 'in')
  endif
endfunction

" Symbol renaming
nmap <Leader>rn <Plug>(coc-rename)

" Diagnostic navigation
nmap <silent> [d <Plug>(coc-diagnostic-prev)
nmap <silent> ]d <Plug>(coc-diagnostic-next)
endif

" ============================================================
" Copilot Settings (AI inline completion)
" ============================================================
" Dismiss suggestion
imap <C-e> <Plug>(copilot-dismiss)
" Cycle through suggestions
imap <M-]> <Plug>(copilot-next)
imap <M-[> <Plug>(copilot-previous)
" Disable for certain filetypes
let g:copilot_filetypes = {
      \ 'gitcommit': v:false,
      \ 'markdown': v:true,
      \ 'yaml': v:true,
      \ }

" ============================================================
" Airline Settings
" ============================================================
let g:airline#extensions#tabline#enabled = 1
let g:airline#extensions#tabline#formatter = 'unique_tail'
" Branch/dirty/untracked VCS checks can stall Vim in large git repos.
let g:airline#extensions#branch#enabled = 0
let g:airline#extensions#hunks#enabled = 1
let g:airline#extensions#tabline#show_tab_nr = 1
let g:airline#extensions#tabline#tab_nr_type = 1
let g:airline#extensions#tabline#show_buffers = 0
" let g:airline#extensions#nerdtree_statusline = 1
let g:airline_theme = 'gruvbox'

" ============================================================
" GitGutter Settings (large-repo performance)
" ============================================================
" Default base_path runs whole-repo rename discovery:
"   git diff --diff-filter=R --name-status [<base>]
" That can make opening buffers slow in large repositories. Override to
" resolve against the current file path only (skip rename enumeration).
if exists('g:loaded_gitgutter')
  silent! runtime autoload/gitgutter/utility.vim
  if exists('*gitgutter#utility#repo_path')
    function! gitgutter#utility#base_path(bufnr) abort
      return gitgutter#utility#shellescape(gitgutter#utility#repo_path(a:bufnr, 0))
    endfunction
  endif
endif

" ============================================================
" Gutentags Settings (ctags)
" ============================================================
let g:gutentags_project_root = ['.git', '.svn', '.project', 'package.json', 'go.mod', 'pom.xml']
let g:gutentags_ctags_tagfile = '.tags'
let g:gutentags_modules = ['ctags']
let g:gutentags_cache_dir = expand('~/.vim/gutentags')
let g:gutentags_ctags_extra_args = ['--fields=+niazS']

" ============================================================
" Language-specific Settings
" ============================================================
" Python
autocmd FileType python setlocal tabstop=4 shiftwidth=4 softtabstop=4

" Go
autocmd FileType go setlocal tabstop=4 shiftwidth=4 softtabstop=4 noexpandtab

" Java
autocmd FileType java setlocal tabstop=4 shiftwidth=4 softtabstop=4

" Shell
autocmd FileType sh,bash,zsh setlocal tabstop=2 shiftwidth=2 softtabstop=2

" YAML / JSON
autocmd FileType yaml,json setlocal tabstop=2 shiftwidth=2 softtabstop=2
