load("//tests/common/rules:devtools_tests.bzl", "devtools_module_tests")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "bash_setup_srcs",
    srcs = [
        "README.md",
        "setup.sh",
    ],
)

exports_files([
    "setup.sh",
    "tests/integration/bash_suite.sh",
])

devtools_module_tests(
    name = "bash",
    suite = ":tests/integration/bash_suite.sh",
    module_root = ":setup.sh",
    module_data = [
        ":bash_setup_srcs",
        "//shell/starship:configs",
    ],
    profiles = [
        "linux_ubuntu",
        "linux_alinux3",
        "linux_alinux4",
        "macos",
    ],
    tags = [
        "cli",
        "smoke",
    ],
)
