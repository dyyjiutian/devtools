{
  "description": "OpenRouter（聚合路由：GPT / Claude / Gemini / Qwen / GLM 等）",
  "provider": "openrouter",
  "name": "OpenRouter",
  "model": "openai/gpt-4o",
  "reasoning_effort": "medium",
  "base_url": "https://openrouter.ai/api/v1",
  "env_var": "OPENROUTER_API_KEY",
  "wire_api": "chat",
  "builtin": false,
  "key_hint": "sk-or-v1-...",
  "model_examples": {
    "gpt4o":          "openai/gpt-4o",
    "gpt5":           "openai/gpt-5",
    "claude_sonnet":  "anthropic/claude-sonnet-4-6",
    "gemini_pro":     "google/gemini-2.5-pro",
    "qwen_plus":      "qwen/qwen-plus",
    "glm4":           "zhipuai/glm-4-plus",
    "deepseek":       "deepseek/deepseek-chat"
  }
}
