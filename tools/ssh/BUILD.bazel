load("//tests/common/rules:devtools_tests.bzl", "devtools_module_tests")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "ssh_srcs",
    srcs = [
        "setup.sh",
        "fssh.sh",
        "README.md",
    ],
)

exports_files([
    "setup.sh",
    "fssh.sh",
    "tests/ssh_suite.sh",
])

devtools_module_tests(
    name = "ssh",
    suite = ":tests/ssh_suite.sh",
    module_root = ":setup.sh",
    module_data = [":ssh_srcs"],
    profiles = [
        "linux_ubuntu",
        "linux_alinux3",
        "linux_alinux4",
        "macos",
    ],
)
