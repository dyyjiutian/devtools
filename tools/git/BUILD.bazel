load("//tests/common/rules:devtools_tests.bzl", "devtools_module_tests")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "git_srcs",
    srcs = glob(
        [
            "setup.sh",
            "scripts/**",
            "bin/**",
            "man/**",
            "README.md",
        ],
        allow_empty = False,
    ),
)

exports_files([
    "setup.sh",
    "tests/git_suite.sh",
])

devtools_module_tests(
    name = "git",
    docker_profiles = [
        "linux_ubuntu",
        "linux_centos",
    ],
    module_data = [
        ":git_srcs",
        "//cache:git_delta_archive",
    ],
    module_root = ":setup.sh",
    profiles = [
        "linux_ubuntu",
        "linux_centos",
        "linux_alinux3",
        "linux_alinux4",
        "macos",
    ],
    suite = ":tests/git_suite.sh",
)
