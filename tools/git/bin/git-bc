#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: git bc [target-branch] [--dry-run] [--deep] [--threshold N] [--jobs N]

Branch clean: delete local branches already merged into origin/<target-branch>.
Detects both regular merges (ancestor) and rebase/squash merges (git cherry).
When target-branch is omitted, the remote default branch from origin/HEAD is used.

Only plain local branches are deleted. Branches checked out in a worktree are
skipped — use git wc to clean those.

Protected branch names are never deleted:
  main, master, develop, dev, and the target branch

The current branch is also skipped.

Rebase/squash detection (git cherry) must patch-id every target-branch commit
since a branch diverged. In very large monorepos this can be tens of thousands
of commits per branch, so by default branches whose target is more than
--threshold commits ahead of them are SKIPPED for the cherry check (they are
still reported so you can rerun with --deep). Cheap branches are checked in
parallel. Use --deep to force the exact check on every branch (slow).

Options:
  -n, --dry-run       Show branches that would be deleted without deleting them
      --deep          Run the exact rebase/squash check on every branch (slow)
  -t, --threshold N   Max commits target may be ahead before skipping the
                      cherry check (default 10000; env GIT_BC_THRESHOLD)
  -j, --jobs N        Parallel git cherry workers (default: min(nproc,8);
                      env GIT_BC_JOBS)
  -h, --help          Show this help

Examples:
  git bc --dry-run
  git bc
  git bc develop --dry-run
  git bc --deep --dry-run
EOF
}

target_branch=""
dry_run=false
deep=false
threshold="${GIT_BC_THRESHOLD:-10000}"
jobs="${GIT_BC_JOBS:-}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -n|--dry-run)
      dry_run=true
      shift
      ;;
    --deep)
      deep=true
      shift
      ;;
    -t|--threshold)
      threshold="${2:-}"
      shift 2
      ;;
    -j|--jobs)
      jobs="${2:-}"
      shift 2
      ;;
    *)
      if [[ -n "$target_branch" ]]; then
        echo "git bc: unexpected argument: $1" >&2
        usage >&2
        exit 1
      fi
      target_branch="$1"
      shift
      ;;
  esac
done

default_branch="$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')"
target_branch="${target_branch:-${default_branch:-main}}"

if [[ -z "$jobs" ]]; then
  n="$(nproc 2>/dev/null || echo 4)"
  jobs=$(( n > 8 ? 8 : n ))
fi

echo "Fetching/pruning origin ..."
git fetch --prune origin

if ! git rev-parse --verify --quiet "origin/$target_branch" >/dev/null; then
  echo "git bc: origin/$target_branch does not exist" >&2
  exit 1
fi

base="origin/$target_branch"
current_branch="$(git branch --show-current 2>/dev/null || true)"

is_protected() {
  case "$1" in
    main|master|develop|dev|"$target_branch") return 0 ;;
    *) return 1 ;;
  esac
}

# Map branch -> worktree path for branches checked out in any worktree.
# Bash 3.2 compatible: no associative arrays (declare -A), so use parallel
# indexed arrays and a linear lookup. Worktree count is small, so O(n) is fine.
wt_branches=()
wt_paths=()
cur_wt=""
while read -r key val; do
  case "$key" in
    worktree) cur_wt="$val" ;;
    branch)
      wt_branches+=("${val#refs/heads/}")
      wt_paths+=("$cur_wt")
      ;;
  esac
done < <(git worktree list --porcelain 2>/dev/null)

to_delete=()
reasons=()
skipped_wt=()
skipped_large=()
cherry_queue=()

echo "Scanning local branches ..."
while read -r branch; do
  [[ -z "$branch" ]] && continue
  is_protected "$branch" && continue
  [[ -n "$current_branch" && "$branch" == "$current_branch" ]] && continue

  wt=""
  for i in "${!wt_branches[@]}"; do
    if [[ "${wt_branches[$i]}" == "$branch" ]]; then
      wt="${wt_paths[$i]}"
      break
    fi
  done
  if [[ -n "$wt" ]]; then
    skipped_wt+=("$branch → $wt")
    continue
  fi

  # Regular merge: branch is an ancestor of the target. Cheap, always checked.
  if git merge-base --is-ancestor "refs/heads/$branch" "$base" 2>/dev/null; then
    to_delete+=("$branch")
    reasons+=("merged")
    continue
  fi

  # Diverged: needs the expensive rebase/squash (git cherry) check.
  if [[ "$deep" == true ]]; then
    cherry_queue+=("$branch")
  else
    ahead="$(git rev-list --count "refs/heads/$branch".."$base" 2>/dev/null || echo 0)"
    if [[ "$ahead" -le "$threshold" ]]; then
      cherry_queue+=("$branch")
    else
      skipped_large+=("$branch (target ahead by $ahead)")
    fi
  fi
done < <(git for-each-ref --format='%(refname:short)' refs/heads/)

# Parallel rebase/squash detection with live progress.
if [[ ${#cherry_queue[@]} -gt 0 ]]; then
  total=${#cherry_queue[@]}
  echo "Checking $total branch(es) for rebase/squash landing (jobs=$jobs) ..."
  checked=0
  while IFS=$'\t' read -r branch verdict; do
    checked=$((checked + 1))
    printf '  [%d/%d] %s → %s\n' "$checked" "$total" "$branch" "$verdict"
    if [[ "$verdict" == "landed" ]]; then
      to_delete+=("$branch")
      reasons+=("rebase")
    fi
  done < <(
    printf '%s\n' "${cherry_queue[@]}" \
      | GIT_BC_BASE="$base" xargs -P "$jobs" -I{} bash -c '
          b="$1"
          # git cherry: "+" = unique patch not in base. No "+" => fully landed.
          if git cherry "$GIT_BC_BASE" "refs/heads/$b" 2>/dev/null | grep -q "^+"; then
            printf "%s\t%s\n" "$b" "ahead"
          else
            printf "%s\t%s\n" "$b" "landed"
          fi
        ' _ {}
  )
fi

if [[ ${#skipped_wt[@]} -gt 0 ]]; then
  echo "Skipped (checked out in a worktree; use git wc):"
  printf '  %s\n' "${skipped_wt[@]}"
fi

if [[ ${#skipped_large[@]} -gt 0 ]]; then
  echo "Skipped rebase/squash check (history too large; rerun with --deep to force):"
  printf '  %s\n' "${skipped_large[@]}"
fi

if [[ ${#to_delete[@]} -eq 0 ]]; then
  echo "No merged local branches to prune."
  exit 0
fi

echo "The following local branches will be deleted:"
for i in "${!to_delete[@]}"; do
  printf '  %s  (%s)\n' "${to_delete[$i]}" "${reasons[$i]}"
done

if [[ "$dry_run" == "true" ]]; then
  exit 0
fi

printf "Proceed? [y/N] "
read -r answer

case "$answer" in
  y|Y|yes|YES)
    for i in "${!to_delete[@]}"; do
      branch="${to_delete[$i]}"
      reason="${reasons[$i]}"
      # Rebase/squash equivalents are not ancestors, so -d would refuse them.
      if [[ "$reason" == "merged" ]]; then
        git branch -d "$branch"
      else
        git branch -D "$branch"
      fi
    done
    ;;
  *)
    echo "Aborted."
    ;;
esac
