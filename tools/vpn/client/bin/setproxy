#!/usr/bin/env bash
# setproxy: 轻量级 VPN 终端代理开关（on / off / status / test）
#
# 支持 macOS / Linux，自动识别常见本地代理端口：
#   macOS V2RayXS: HTTP 8001 / SOCKS 1081
#   Xray CLI:     HTTP 10809 / SOCKS 10808
#
# 当前 shell 立即生效：
#   source setproxy on
#   eval "$(setproxy on --emit)"
#
# Git SSH 地址走 SOCKS：
#   setproxy 默认导出 GIT_SSH_COMMAND，通过 nc 连接 SOCKS5。
#   这不会修改 ~/.ssh/config；可用 --no-git-ssh 禁用。

set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; BOLD='\033[1m'; RESET='\033[0m'

ACTION=""
EMIT=false
CLI_HTTP_HOST=""
CLI_HTTP_PORT=""
CLI_SOCKS_HOST=""
CLI_SOCKS_PORT=""
CLI_GIT_SSH_PROXY=""

usage() {
    cat <<'HELP'
用法: setproxy on | off | status | test [选项]

  on      开启终端代理，写入 ~/.config/vpn/proxy.env
  off     关闭终端代理
  status  查看代理配置、环境变量和本地端口
  test    测试常用站点连通性及国内/海外下载速度

选项:
  --emit                 仅向标准输出打印可供 eval 执行的 shell 代码
  --http-host HOST       指定 HTTP 代理主机
  --http-port PORT       指定 HTTP 代理端口
  --socks-host HOST      指定 SOCKS5 代理主机
  --socks-port PORT      指定 SOCKS5 代理端口
  --no-git-ssh           不为 Git SSH 导出 GIT_SSH_COMMAND
  --git-ssh              为 Git SSH 导出 GIT_SSH_COMMAND
  -h, --help             显示帮助

配置优先级:
  命令行参数 > VPN_* 环境变量 > ~/.config/vpn/setproxy.conf
  > 已监听端口自动识别 > 操作系统默认值

环境变量:
  VPN_HTTP_HOST / VPN_HTTP_PORT
  VPN_SOCKS_HOST / VPN_SOCKS_PORT
  VPN_GIT_SSH_PROXY=true|false
HELP
}

emit_mode_log() {
    if $EMIT; then
        echo -e "$*" >&2
    else
        echo -e "$*"
    fi
}

info()    { emit_mode_log "${BLUE}[INFO]${RESET}  $*"; }
success() { emit_mode_log "${GREEN}[OK]${RESET}    $*"; }
warn()    { echo -e "${YELLOW}[WARN]${RESET}  $*" >&2; }
error()   { echo -e "${RED}[ERROR]${RESET} $*" >&2; }

need_value() {
    local option="$1" value="${2:-}"
    if [[ -z "$value" ]]; then
        error "${option} 缺少参数"
        exit 1
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        on|off|status|test)
            if [[ -n "$ACTION" && "$ACTION" != "$1" ]]; then
                error "只能指定一个操作"
                exit 1
            fi
            ACTION="$1"
            shift
            ;;
        --emit)
            EMIT=true
            shift
            ;;
        --http-host=*)  CLI_HTTP_HOST="${1#*=}"; shift ;;
        --http-port=*)  CLI_HTTP_PORT="${1#*=}"; shift ;;
        --socks-host=*) CLI_SOCKS_HOST="${1#*=}"; shift ;;
        --socks-port=*) CLI_SOCKS_PORT="${1#*=}"; shift ;;
        --http-host|--http-port|--socks-host|--socks-port)
            option="$1"
            shift
            need_value "$option" "${1:-}"
            case "$option" in
                --http-host)  CLI_HTTP_HOST="$1" ;;
                --http-port)  CLI_HTTP_PORT="$1" ;;
                --socks-host) CLI_SOCKS_HOST="$1" ;;
                --socks-port) CLI_SOCKS_PORT="$1" ;;
            esac
            shift
            ;;
        --no-git-ssh)
            CLI_GIT_SSH_PROXY=false
            shift
            ;;
        --git-ssh)
            CLI_GIT_SSH_PROXY=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            error "未知参数: $1"
            usage >&2
            exit 1
            ;;
    esac
done

if [[ -z "$ACTION" ]]; then
    usage
    exit 1
fi

PROXY_DIR="${HOME}/.config/vpn"
PROXY_ENV="${PROXY_DIR}/proxy.env"
CONFIG_FILE="${PROXY_DIR}/setproxy.conf"
MARKER_BEGIN="# >>> vpn-shell-proxy managed >>>"
MARKER_END="# <<< vpn-shell-proxy managed <<<"
HOOK_LINE='[ -f "${HOME}/.config/vpn/proxy.env" ] && . "${HOME}/.config/vpn/proxy.env"'

IS_DARWIN=false
[[ "$(uname)" == "Darwin" ]] && IS_DARWIN=true

port_listening() {
    local port="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -tln 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]${port}$"
    elif command -v lsof >/dev/null 2>&1; then
        lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1
    else
        return 1
    fi
}

CONFIG_HTTP_HOST=""
CONFIG_HTTP_PORT=""
CONFIG_SOCKS_HOST=""
CONFIG_SOCKS_PORT=""
CONFIG_GIT_SSH_PROXY=""

load_config() {
    [[ -f "$CONFIG_FILE" ]] || return 0
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
}

first_nonempty() {
    local value
    for value in "$@"; do
        if [[ -n "$value" ]]; then
            printf '%s' "$value"
            return 0
        fi
    done
}

detect_default_ports() {
    DETECTED_HTTP_PORT=""
    DETECTED_SOCKS_PORT=""

    if $IS_DARWIN; then
        if port_listening 8001 && port_listening 1081; then
            DETECTED_HTTP_PORT=8001
            DETECTED_SOCKS_PORT=1081
        elif port_listening 10809 && port_listening 10808; then
            DETECTED_HTTP_PORT=10809
            DETECTED_SOCKS_PORT=10808
        elif port_listening 8001 || port_listening 1081; then
            DETECTED_HTTP_PORT=8001
            DETECTED_SOCKS_PORT=1081
        elif port_listening 10809 || port_listening 10808; then
            DETECTED_HTTP_PORT=10809
            DETECTED_SOCKS_PORT=10808
        else
            DETECTED_HTTP_PORT=8001
            DETECTED_SOCKS_PORT=1081
        fi
    else
        if port_listening 10809 && port_listening 10808; then
            DETECTED_HTTP_PORT=10809
            DETECTED_SOCKS_PORT=10808
        elif port_listening 8001 && port_listening 1081; then
            DETECTED_HTTP_PORT=8001
            DETECTED_SOCKS_PORT=1081
        elif port_listening 10809 || port_listening 10808; then
            DETECTED_HTTP_PORT=10809
            DETECTED_SOCKS_PORT=10808
        elif port_listening 8001 || port_listening 1081; then
            DETECTED_HTTP_PORT=8001
            DETECTED_SOCKS_PORT=1081
        else
            DETECTED_HTTP_PORT=10809
            DETECTED_SOCKS_PORT=10808
        fi
    fi
}

validate_host() {
    local label="$1" value="$2"
    if [[ ! "$value" =~ ^[A-Za-z0-9._:-]+$ ]]; then
        error "${label} 包含不支持的字符: ${value}"
        exit 1
    fi
}

validate_port() {
    local label="$1" value="$2"
    if [[ ! "$value" =~ ^[0-9]+$ ]] || (( value < 1 || value > 65535 )); then
        error "${label} 必须是 1-65535 的端口号: ${value}"
        exit 1
    fi
}

normalize_bool() {
    case "${1:-}" in
        true|TRUE|yes|YES|1|on|ON) printf 'true' ;;
        false|FALSE|no|NO|0|off|OFF) printf 'false' ;;
        *)
            error "VPN_GIT_SSH_PROXY 只能是 true 或 false"
            exit 1
            ;;
    esac
}

load_config
detect_default_ports

HTTP_HOST="$(first_nonempty "$CLI_HTTP_HOST" "${VPN_HTTP_HOST:-}" "$CONFIG_HTTP_HOST" "127.0.0.1")"
HTTP_PORT="$(first_nonempty "$CLI_HTTP_PORT" "${VPN_HTTP_PORT:-}" "$CONFIG_HTTP_PORT" "$DETECTED_HTTP_PORT")"
SOCKS_HOST="$(first_nonempty "$CLI_SOCKS_HOST" "${VPN_SOCKS_HOST:-}" "$CONFIG_SOCKS_HOST" "127.0.0.1")"
SOCKS_PORT="$(first_nonempty "$CLI_SOCKS_PORT" "${VPN_SOCKS_PORT:-}" "$CONFIG_SOCKS_PORT" "$DETECTED_SOCKS_PORT")"
GIT_SSH_PROXY="$(normalize_bool "$(first_nonempty "$CLI_GIT_SSH_PROXY" "${VPN_GIT_SSH_PROXY:-}" "$CONFIG_GIT_SSH_PROXY" "true")")"

validate_host "HTTP 代理主机" "$HTTP_HOST"
validate_host "SOCKS 代理主机" "$SOCKS_HOST"
validate_port "HTTP 代理端口" "$HTTP_PORT"
validate_port "SOCKS 代理端口" "$SOCKS_PORT"

ensure_shell_hook() {
    local rc="$1"
    [[ -f "$rc" ]] || return 0
    grep -qF "$MARKER_BEGIN" "$rc" 2>/dev/null && return 0
    {
        echo ""
        echo "$MARKER_BEGIN"
        echo "$HOOK_LINE"
        echo "$MARKER_END"
    } >> "$rc"
    info "已写入 shell 钩子: ${rc}"
}

write_config() {
    mkdir -p "$PROXY_DIR"
    {
        echo "# setproxy configuration — managed by setproxy"
        printf 'CONFIG_HTTP_HOST="%s"\n' "$HTTP_HOST"
        printf 'CONFIG_HTTP_PORT="%s"\n' "$HTTP_PORT"
        printf 'CONFIG_SOCKS_HOST="%s"\n' "$SOCKS_HOST"
        printf 'CONFIG_SOCKS_PORT="%s"\n' "$SOCKS_PORT"
        printf 'CONFIG_GIT_SSH_PROXY="%s"\n' "$GIT_SSH_PROXY"
    } > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
}

nc_supports_proxy() {
    command -v nc >/dev/null 2>&1 || return 1
    local help
    help="$(nc -h 2>&1 || true)"
    grep -q -- '-x' <<< "$help" && grep -q -- '-X' <<< "$help"
}

write_proxy_env() {
    mkdir -p "$PROXY_DIR"
    {
        echo "# VPN shell proxy — managed by setproxy"
        printf 'export http_proxy="%s"\n' "http://${HTTP_HOST}:${HTTP_PORT}"
        printf 'export https_proxy="%s"\n' "http://${HTTP_HOST}:${HTTP_PORT}"
        printf 'export HTTP_PROXY="%s"\n' "http://${HTTP_HOST}:${HTTP_PORT}"
        printf 'export HTTPS_PROXY="%s"\n' "http://${HTTP_HOST}:${HTTP_PORT}"
        printf 'export all_proxy="%s"\n' "socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
        printf 'export ALL_PROXY="%s"\n' "socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
        printf 'export no_proxy="%s"\n' "127.0.0.1,localhost,::1"
        printf 'export NO_PROXY="%s"\n' "127.0.0.1,localhost,::1"
        if [[ "$GIT_SSH_PROXY" == "true" ]]; then
            printf 'export GIT_SSH_COMMAND=%q\n' \
                "ssh -o ProxyCommand=\"nc -x ${SOCKS_HOST}:${SOCKS_PORT} -X 5 %h %p\""
        else
            echo "unset GIT_SSH_COMMAND"
        fi
    } > "$PROXY_ENV"
    chmod 600 "$PROXY_ENV"
}

emit_exports() {
    grep -E '^(export|unset) ' "$PROXY_ENV"
}

emit_unsets() {
    echo "unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY no_proxy NO_PROXY GIT_SSH_COMMAND"
}

is_sourced() {
    if [[ -n "${ZSH_EVAL_CONTEXT:-}" && "${ZSH_EVAL_CONTEXT}" == *:file ]]; then
        return 0
    fi
    [[ "${BASH_SOURCE[0]:-}" != "$0" ]]
}

apply_to_current_shell() {
    if is_sourced; then
        # shellcheck disable=SC1090
        . "$PROXY_ENV"
        success "当前 shell 已加载代理环境变量"
    fi
}

clear_current_shell() {
    if is_sourced; then
        unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
        unset all_proxy ALL_PROXY no_proxy NO_PROXY GIT_SSH_COMMAND
    fi
}

log_hint() {
    echo -e "${BOLD}━━━ 查看代理客户端是否正常工作 ━━━${RESET}"
    if $IS_DARWIN; then
        echo "  V2RayXS 进程: pgrep -fl 'V2RayXS|xray'"
        echo "  端口监听    : lsof -nP -iTCP:${HTTP_PORT} -iTCP:${SOCKS_PORT} -sTCP:LISTEN"
        echo "  Xray LaunchAgent: launchctl list | grep com.vpn.xray-client"
        echo "  Xray 日志       : tail -f /tmp/xray-client.log"
    else
        echo "  服务状态 : systemctl status xray-client"
        echo "  最近日志 : journalctl -u xray-client -n 50 --no-pager"
        echo "  实时日志 : journalctl -u xray-client -f"
    fi
}

curl_request() {
    local proxy_arg="$1"
    shift
    if [[ -n "$proxy_arg" ]]; then
        curl -x "$proxy_arg" "$@"
    else
        curl --proxy '' --noproxy '*' "$@"
    fi
}

check_site() {
    local label="$1" proxy_arg="$2" url="$3" tolerate_403="${4:-false}" code
    code="$(curl_request "$proxy_arg" -sSL --connect-timeout 8 --max-time 15 \
        -o /dev/null -w "%{http_code}" "$url" 2>/dev/null)" || code="000"
    if [[ "$code" =~ ^2 ]] || { [[ "$tolerate_403" == "true" ]] && [[ "$code" == "403" ]]; }; then
        echo -e "  ${label} ${GREEN}HTTP ${code}${RESET}"
        return 0
    fi
    echo -e "  ${label} ${RED}HTTP ${code}${RESET}"
    return 1
}

speed_test() {
    local label="$1" proxy_arg="$2" url="$3"
    local stats code time_total size speed_bps kbps mbps
    stats="$(curl_request "$proxy_arg" -sSL --connect-timeout 10 --max-time 30 \
        -o /dev/null -w "%{http_code} %{time_total} %{size_download} %{speed_download}" \
        "$url" 2>/dev/null)" || stats="000 0 0 0"
    read -r code time_total size speed_bps <<< "$stats"
    if [[ "$code" =~ ^2 ]]; then
        kbps="$(awk -v b="$speed_bps" 'BEGIN{printf "%.0f", b/1024}')"
        mbps="$(awk -v b="$speed_bps" 'BEGIN{printf "%.2f", b*8/1000000}')"
        echo -e "  ${label} ${GREEN}${kbps} KB/s（约 ${mbps} Mbps，${size} bytes，耗时 ${time_total}s）${RESET}"
        return 0
    fi
    echo -e "  ${label} ${RED}下载失败 (HTTP ${code})${RESET}"
    return 1
}

do_on() {
    if ! port_listening "$HTTP_PORT"; then
        warn "HTTP 代理端口 ${HTTP_HOST}:${HTTP_PORT} 未监听，请确认代理客户端已启动"
    fi
    if ! port_listening "$SOCKS_PORT"; then
        warn "SOCKS 代理端口 ${SOCKS_HOST}:${SOCKS_PORT} 未监听，请确认代理客户端已启动"
    fi
    if [[ "$GIT_SSH_PROXY" == "true" ]] && ! nc_supports_proxy; then
        warn "当前 nc 不支持 -x/-X，Git SSH 代理可能不可用；可用 --no-git-ssh 禁用"
    fi

    write_config
    write_proxy_env
    ensure_shell_hook "${HOME}/.bashrc"
    ensure_shell_hook "${HOME}/.zshrc"
    ensure_shell_hook "${HOME}/.profile"

    if $EMIT; then
        emit_exports
        return 0
    fi

    success "终端代理已开启（新开的终端自动生效）"
    info "HTTP/HTTPS → http://${HTTP_HOST}:${HTTP_PORT}"
    info "ALL_PROXY  → socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
    if [[ "$GIT_SSH_PROXY" == "true" ]]; then
        info "Git SSH    → SOCKS5 ${SOCKS_HOST}:${SOCKS_PORT}（未修改 ~/.ssh/config）"
    else
        info "Git SSH    → 未启用"
    fi
    info "配置文件   → ${PROXY_ENV}"

    apply_to_current_shell
    if ! is_sourced; then
        echo ""
        warn "当前已打开的终端需手动加载一次:"
        echo "  source ${PROXY_ENV}"
        echo "  或: eval \"\$(setproxy on --emit)\""
    fi
}

do_off() {
    rm -f "$PROXY_ENV"
    clear_current_shell

    if $EMIT; then
        emit_unsets
        success "终端代理已关闭"
        return 0
    fi

    success "终端代理已关闭（新开的终端将直连）"
    if ! is_sourced; then
        echo ""
        info "当前已打开的终端请执行:"
        echo "  eval \"\$(setproxy off --emit)\""
    fi
    echo ""
    warn "这只关闭终端环境变量，不会停止代理客户端本身"
}

do_status() {
    echo -e "${BOLD}配置文件${RESET}"
    if [[ -f "$PROXY_ENV" ]]; then
        echo -e "  状态: ${GREEN}已开启${RESET}"
        echo "  环境: ${PROXY_ENV}"
    else
        echo -e "  状态: ${YELLOW}已关闭${RESET}"
    fi
    echo "  参数: ${CONFIG_FILE}"
    echo "  HTTP: http://${HTTP_HOST}:${HTTP_PORT}"
    echo "  SOCKS: socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
    echo "  Git SSH 代理: ${GIT_SSH_PROXY}"

    echo ""
    echo -e "${BOLD}当前 shell 环境变量${RESET}"
    local any=false value variable
    for variable in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY GIT_SSH_COMMAND; do
        eval "value=\${${variable}:-}"
        if [[ -n "$value" ]]; then
            echo "  ${variable}=${value}"
            any=true
        fi
    done
    $any || echo "  （未设置）"

    echo ""
    echo -e "${BOLD}本地代理端口${RESET}"
    if port_listening "$HTTP_PORT"; then
        echo -e "  HTTP  ${HTTP_HOST}:${HTTP_PORT} ${GREEN}监听中${RESET}"
    else
        echo -e "  HTTP  ${HTTP_HOST}:${HTTP_PORT} ${RED}未监听${RESET}"
    fi
    if port_listening "$SOCKS_PORT"; then
        echo -e "  SOCKS ${SOCKS_HOST}:${SOCKS_PORT} ${GREEN}监听中${RESET}"
    else
        echo -e "  SOCKS ${SOCKS_HOST}:${SOCKS_PORT} ${RED}未监听${RESET}"
    fi

    echo ""
    log_hint
}

do_test() {
    local ok=true
    local http_proxy_arg="http://${HTTP_HOST}:${HTTP_PORT}"
    local socks_proxy_arg="socks5h://${SOCKS_HOST}:${SOCKS_PORT}"

    echo -e "${BOLD}━━━ 1. 配置与端口 ━━━${RESET}"
    echo "  HTTP 代理 : ${http_proxy_arg}"
    echo "  SOCKS代理 : ${socks_proxy_arg}"
    if port_listening "$HTTP_PORT"; then
        echo -e "  HTTP  端口 ${HTTP_PORT}: ${GREEN}监听中${RESET}"
    else
        echo -e "  HTTP  端口 ${HTTP_PORT}: ${RED}未监听${RESET}"
        ok=false
    fi
    if port_listening "$SOCKS_PORT"; then
        echo -e "  SOCKS 端口 ${SOCKS_PORT}: ${GREEN}监听中${RESET}"
    else
        echo -e "  SOCKS 端口 ${SOCKS_PORT}: ${RED}未监听${RESET}"
        ok=false
    fi

    echo ""
    echo -e "${BOLD}━━━ 2. 常用站点连通性（海外经代理 / 国内强制直连）━━━${RESET}"
    check_site "ipify.org       (HTTP代理) :" "$http_proxy_arg"  "https://api4.ipify.org" false || ok=false
    check_site "google.com      (SOCKS代理):" "$socks_proxy_arg" "https://www.google.com/" false || ok=false
    check_site "github.com      (SOCKS代理):" "$socks_proxy_arg" "https://github.com/" false || ok=false
    check_site "githubusercontent.com(SOCKS):" "$socks_proxy_arg" "https://raw.githubusercontent.com/" false || ok=false
    check_site "docker.io       (SOCKS代理):" "$socks_proxy_arg" "https://docker.io/" false || ok=false
    check_site "claude.ai       (SOCKS代理):" "$socks_proxy_arg" "https://claude.ai/" true || ok=false
    check_site "www.baidu.com   (强制直连) :" "" "https://www.baidu.com/" false || ok=false

    echo ""
    echo -e "${BOLD}━━━ 3. 基准测速（海外经代理 / 国内强制直连）━━━${RESET}"
    speed_test "海外(经代理) Cloudflare 10MB:" "$socks_proxy_arg" "https://speed.cloudflare.com/__down?bytes=10000000" || ok=false
    speed_test "国内(直连)   阿里云镜像     :" "" "https://mirrors.aliyun.com/centos/7/isos/x86_64/CentOS-7-x86_64-Everything-2009.torrent" || ok=false

    echo ""
    if $ok; then
        success "代理测试通过"
    else
        error "代理测试未完全通过，请检查代理客户端和路由配置"
        echo ""
        log_hint
        return 1
    fi
}

case "$ACTION" in
    on)     do_on ;;
    off)    do_off ;;
    status) do_status ;;
    test)   do_test ;;
esac
