#!/usr/bin/env bash
# setproxy: 轻量级 VPN 终端代理开关（on / off / status / test）
#
# 自包含脚本，安装到 ~/.local/bin 后即使删除本仓库依然可用（见同目录
# ../install-setproxy.sh）。管理的配置文件与 linux_setup.sh / macos_setup.sh
# 的 `proxy` 子命令完全一致（~/.config/vpn/proxy.env），可互操作，二者任选
# 一个开关即可。
#
# 用法:
#   setproxy on       开启终端代理（写入 proxy.env 并挂载到 shell rc）
#   setproxy off      关闭终端代理
#   setproxy status   查看代理状态 + 端口监听 + xray 日志查看方式
#   setproxy test     测试代理端口 + 常用站点连通性（google/github/
#                     githubusercontent/docker.io/claude.ai/百度）+ 海外/国内基准测速
#
# 当前 shell 立即生效:
#   source setproxy on
#   eval "$(setproxy on --emit)"
#
# 环境变量覆盖（可选）:
#   VPN_SOCKS_HOST / VPN_SOCKS_PORT / VPN_HTTP_HOST / VPN_HTTP_PORT

set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${BLUE}[INFO]${RESET}  $*"; }
success() { echo -e "${GREEN}[OK]${RESET}    $*"; }
warn()    { echo -e "${YELLOW}[WARN]${RESET}  $*"; }
error()   { echo -e "${RED}[ERROR]${RESET} $*" >&2; }

usage() {
    cat <<'HELP'
用法: setproxy on | off | status | test

  on      开启终端代理环境变量（写入 ~/.config/vpn/proxy.env，自动加载到
          ~/.bashrc / ~/.zshrc / ~/.profile；新开终端自动生效）
  off     关闭终端代理环境变量
  status  查看当前代理状态、端口监听情况，以及 xray 日志查看方式
  test    测试代理端口 + 常用站点连通性（google/github/githubusercontent/
          docker.io/claude.ai/百度）+ 海外/国内基准测速，可用于临时排障

当前 shell 立即生效:
  source setproxy on
  eval "$(setproxy on --emit)"

环境变量覆盖（可选）:
  VPN_SOCKS_HOST / VPN_SOCKS_PORT / VPN_HTTP_HOST / VPN_HTTP_PORT

本命令与 devtools 仓库 tools/vpn/client 下 linux_setup.sh / macos_setup.sh 的
proxy 子命令共享同一份配置（~/.config/vpn/proxy.env），可互操作。若尚未部署
Xray 客户端，请先运行 client/linux_setup.sh install 或 client/macos_setup.sh install。
HELP
}

ACTION=""
EMIT=false
for arg in "$@"; do
    case "$arg" in
        on|off|status|test) ACTION="$arg" ;;
        --emit)              EMIT=true ;;
        --help|-h)            usage; exit 0 ;;
        *) warn "未知参数: $arg" ;;
    esac
done

if [[ -z "$ACTION" ]]; then
    usage
    exit 1
fi

PROXY_DIR="${HOME}/.config/vpn"
PROXY_ENV="${PROXY_DIR}/proxy.env"
MARKER_BEGIN="# >>> vpn-shell-proxy managed >>>"
MARKER_END="# <<< vpn-shell-proxy managed <<<"
HOOK_LINE='[ -f "${HOME}/.config/vpn/proxy.env" ] && . "${HOME}/.config/vpn/proxy.env"'

SOCKS_HOST="${VPN_SOCKS_HOST:-127.0.0.1}"
HTTP_HOST="${VPN_HTTP_HOST:-127.0.0.1}"
SOCKS_PORT="${VPN_SOCKS_PORT:-10808}"
HTTP_PORT="${VPN_HTTP_PORT:-10809}"

IS_DARWIN=false
[[ "$(uname)" == "Darwin" ]] && IS_DARWIN=true

port_listening() {
    local p="$1"
    if command -v ss &>/dev/null; then
        ss -tln 2>/dev/null | grep -q ":${p} "
    elif command -v lsof &>/dev/null; then
        lsof -iTCP:"$p" -sTCP:LISTEN &>/dev/null
    else
        return 1
    fi
}

ensure_shell_hook() {
    local rc="$1"
    [[ -f "$rc" ]] || return 0
    grep -qF "$MARKER_BEGIN" "$rc" 2>/dev/null && return 0
    {
        echo ""
        echo "$MARKER_BEGIN"
        echo "$HOOK_LINE"
        echo "$MARKER_END"
    } >> "$rc"
    info "已写入 shell 钩子: ${rc}"
}

write_proxy_env() {
    mkdir -p "$PROXY_DIR"
    cat > "$PROXY_ENV" <<EOF
# VPN shell proxy — managed by setproxy
export http_proxy="http://${HTTP_HOST}:${HTTP_PORT}"
export https_proxy="http://${HTTP_HOST}:${HTTP_PORT}"
export HTTP_PROXY="http://${HTTP_HOST}:${HTTP_PORT}"
export HTTPS_PROXY="http://${HTTP_HOST}:${HTTP_PORT}"
export all_proxy="socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
export ALL_PROXY="socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
export no_proxy="127.0.0.1,localhost"
export NO_PROXY="127.0.0.1,localhost"
EOF
    chmod 600 "$PROXY_ENV"
}

emit_exports() { grep -E '^export ' "$PROXY_ENV"; }

apply_to_current_shell() {
    if [[ "${BASH_SOURCE[0]:-}" != "${0}" ]]; then
        # shellcheck disable=SC1090
        source "$PROXY_ENV"
        success "当前 shell 已加载代理环境变量"
    fi
}

clear_current_shell() {
    if [[ "${BASH_SOURCE[0]:-}" != "${0}" ]]; then
        unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
        unset all_proxy ALL_PROXY no_proxy NO_PROXY
    fi
}

log_hint() {
    echo -e "${BOLD}━━━ 查看 Xray 是否正常工作 ━━━${RESET}"
    if $IS_DARWIN; then
        echo "  进程状态 : launchctl list | grep com.vpn.xray-client"
        echo "  实时日志 : tail -f /tmp/xray-client.log"
    else
        echo "  服务状态 : systemctl status xray-client"
        echo "  最近日志 : journalctl -u xray-client -n 50 --no-pager"
        echo "  实时日志 : journalctl -u xray-client -f"
    fi
}

# 站点连通性检查：proxy_arg 为空则直连（用于验证国内直连站点）
# tolerate_403：某些站点（如 claude.ai）走 Cloudflare，403 也视为代理已通
check_site() {
    local label="$1" proxy_arg="$2" url="$3" tolerate_403="${4:-false}" code
    if [[ -n "$proxy_arg" ]]; then
        code=$(curl -x "$proxy_arg" -sSL --connect-timeout 8 --max-time 15 \
            -o /dev/null -w "%{http_code}" "$url" 2>/dev/null) || code="000"
    else
        code=$(curl -sSL --connect-timeout 8 --max-time 15 \
            -o /dev/null -w "%{http_code}" "$url" 2>/dev/null) || code="000"
    fi
    if [[ "$code" =~ ^2 ]] || { [[ "$tolerate_403" == "true" ]] && [[ "$code" == "403" ]]; }; then
        echo -e "  ${label} ${GREEN}HTTP ${code}${RESET}"
        return 0
    fi
    echo -e "  ${label} ${RED}HTTP ${code}${RESET}"
    return 1
}

# 基准测速：下载固定大小的测试文件，估算吞吐率（仅供粗略参考，会随网络波动）
speed_test() {
    local label="$1" proxy_arg="$2" url="$3"
    local stats code time_total size speed_bps kbps mbps
    if [[ -n "$proxy_arg" ]]; then
        stats=$(curl -x "$proxy_arg" -sSL --connect-timeout 10 --max-time 30 \
            -o /dev/null -w "%{http_code} %{time_total} %{size_download} %{speed_download}" "$url" 2>/dev/null) || stats="000 0 0 0"
    else
        stats=$(curl -sSL --connect-timeout 10 --max-time 30 \
            -o /dev/null -w "%{http_code} %{time_total} %{size_download} %{speed_download}" "$url" 2>/dev/null) || stats="000 0 0 0"
    fi
    read -r code time_total size speed_bps <<< "$stats"
    if [[ "$code" =~ ^2 ]]; then
        kbps=$(awk -v b="$speed_bps" 'BEGIN{printf "%.0f", b/1024}')
        mbps=$(awk -v b="$speed_bps" 'BEGIN{printf "%.2f", b*8/1000000}')
        echo -e "  ${label} ${GREEN}${kbps} KB/s（约 ${mbps} Mbps，${size} bytes，耗时 ${time_total}s）${RESET}"
        return 0
    fi
    echo -e "  ${label} ${RED}下载失败 (HTTP ${code})${RESET}"
    return 1
}

do_on() {
    if ! port_listening "$HTTP_PORT"; then
        warn "HTTP 代理端口 ${HTTP_HOST}:${HTTP_PORT} 未监听，请先部署并启动 Xray 客户端"
    fi
    if ! port_listening "$SOCKS_PORT"; then
        warn "SOCKS 代理端口 ${SOCKS_HOST}:${SOCKS_PORT} 未监听，请先部署并启动 Xray 客户端"
    fi

    write_proxy_env
    ensure_shell_hook "${HOME}/.bashrc"
    [[ -f "${HOME}/.zshrc"   ]] && ensure_shell_hook "${HOME}/.zshrc"
    [[ -f "${HOME}/.profile" ]] && ensure_shell_hook "${HOME}/.profile"

    if $EMIT; then
        emit_exports
        return 0
    fi

    success "终端代理已开启（新开的终端自动生效）"
    info "HTTP/HTTPS → http://${HTTP_HOST}:${HTTP_PORT}"
    info "ALL_PROXY  → socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
    info "配置文件   → ${PROXY_ENV}"

    apply_to_current_shell
    if [[ "${BASH_SOURCE[0]:-}" == "${0}" ]]; then
        echo ""
        warn "当前已打开的终端需手动加载一次:"
        echo "  source ${PROXY_ENV}"
        echo "  或: eval \"\$(setproxy on --emit)\""
    fi
}

do_off() {
    rm -f "$PROXY_ENV"
    success "终端代理已关闭（新开的终端将直连）"
    clear_current_shell
    if [[ "${BASH_SOURCE[0]:-}" == "${0}" ]]; then
        echo ""
        info "当前已打开的终端请执行:"
        echo "  unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY no_proxy NO_PROXY"
    fi
    echo ""
    warn "注意：这只是关闭终端环境变量，Xray 客户端服务本身仍在后台运行"
    warn "（本机 ${HTTP_PORT}/${SOCKS_PORT} 端口仍监听，setproxy test 直连测试仍会显示可用）"
    if $IS_DARWIN; then
        info "如需彻底停止代理，请执行: launchctl unload ~/Library/LaunchAgents/com.vpn.xray-client.plist"
    else
        info "如需彻底停止代理，请执行: sudo systemctl stop xray-client"
    fi
}

do_status() {
    echo -e "${BOLD}配置文件${RESET}"
    if [[ -f "$PROXY_ENV" ]]; then
        echo -e "  状态: ${GREEN}已开启${RESET}"
        echo "  路径: ${PROXY_ENV}"
    else
        echo -e "  状态: ${YELLOW}已关闭${RESET}（${PROXY_ENV} 不存在）"
    fi

    echo ""
    echo -e "${BOLD}当前 shell 环境变量${RESET}"
    local any=false
    for v in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY; do
        if [[ -n "${!v:-}" ]]; then
            echo "  ${v}=${!v}"
            any=true
        fi
    done
    $any || echo "  （未设置——若刚 on，请 source 一次或新开终端）"

    echo ""
    echo -e "${BOLD}Xray 本地端口${RESET}"
    if port_listening "$HTTP_PORT"; then
        echo -e "  HTTP  ${HTTP_HOST}:${HTTP_PORT} ${GREEN}监听中${RESET}"
    else
        echo -e "  HTTP  ${HTTP_HOST}:${HTTP_PORT} ${RED}未监听${RESET}"
    fi
    if port_listening "$SOCKS_PORT"; then
        echo -e "  SOCKS ${SOCKS_HOST}:${SOCKS_PORT} ${GREEN}监听中${RESET}"
    else
        echo -e "  SOCKS ${SOCKS_HOST}:${SOCKS_PORT} ${RED}未监听${RESET}"
    fi

    echo ""
    log_hint
}

do_test() {
    local ok=true

    echo -e "${BOLD}━━━ 1. 配置与端口 ━━━${RESET}"
    if [[ -f "$PROXY_ENV" ]]; then
        echo -e "  proxy.env: ${GREEN}存在${RESET} (${PROXY_ENV})"
    else
        echo -e "  proxy.env: ${YELLOW}不存在${RESET}（尚未 setproxy on，以下仍按固定端口测试）"
    fi
    echo -e "  ${YELLOW}注意：以下测试直连 Xray 本地端口，与 on/off 无关——${RESET}"
    echo -e "  ${YELLOW}on/off 只切换 shell 环境变量，不会启停 Xray 客户端服务本身${RESET}"
    if [[ -n "${http_proxy:-}${all_proxy:-}" ]]; then
        echo -e "  当前 shell 环境变量: ${GREEN}已设置${RESET}"
    else
        echo -e "  当前 shell 环境变量: ${YELLOW}未设置${RESET}（不影响本次测试，测试直接使用固定端口）"
    fi

    if port_listening "$HTTP_PORT"; then
        echo -e "  HTTP  端口 ${HTTP_PORT}: ${GREEN}监听中${RESET}"
    else
        echo -e "  HTTP  端口 ${HTTP_PORT}: ${RED}未监听${RESET}"
        ok=false
    fi
    if port_listening "$SOCKS_PORT"; then
        echo -e "  SOCKS 端口 ${SOCKS_PORT}: ${GREEN}监听中${RESET}"
    else
        echo -e "  SOCKS 端口 ${SOCKS_PORT}: ${RED}未监听${RESET}"
        ok=false
    fi

    local http_proxy_arg="http://${HTTP_HOST}:${HTTP_PORT}"
    local socks_proxy_arg="socks5h://${SOCKS_HOST}:${SOCKS_PORT}"

    echo ""
    echo -e "${BOLD}━━━ 2. 常用站点连通性（海外经代理 / 国内直连，不依赖当前 shell 变量）━━━${RESET}"
    check_site "ipify.org       (HTTP代理) :" "$http_proxy_arg"   "https://api4.ipify.org"  false || ok=false
    check_site "google.com      (SOCKS代理):" "$socks_proxy_arg"  "https://www.google.com/" false || ok=false
    check_site "github.com      (SOCKS代理):" "$socks_proxy_arg"  "https://github.com/"     false || ok=false
    check_site "githubusercontent.com(SOCKS):" "$socks_proxy_arg" "https://raw.githubusercontent.com/" false || ok=false
    check_site "docker.io       (SOCKS代理):" "$socks_proxy_arg"  "https://docker.io/"      false || ok=false
    check_site "claude.ai       (SOCKS代理):" "$socks_proxy_arg"  "https://claude.ai/"      true  || ok=false
    check_site "www.baidu.com   (直连)     :" ""                  "https://www.baidu.com/"  false || ok=false
    echo -e "  ${YELLOW}提示：claude.ai 出现 403 也可能是代理已通，属 Cloudflare 策略${RESET}"

    echo ""
    echo -e "${BOLD}━━━ 3. 基准测速（海外经代理 / 国内直连，仅供粗略参考）━━━${RESET}"
    speed_test "海外(经代理) OVH 1MB 测试文件:" "$socks_proxy_arg" "https://proof.ovh.net/files/1Mb.dat" || ok=false
    speed_test "国内(直连)   阿里云镜像     :" "" "https://mirrors.aliyun.com/centos/7/isos/x86_64/CentOS-7-x86_64-Everything-2009.torrent" || ok=false

    echo ""
    if $ok; then
        success "代理测试通过：端口监听正常，且可经代理访问外网"
    else
        error "代理测试未完全通过，请检查 Xray 客户端是否正常运行"
        echo ""
        log_hint
    fi
}

case "$ACTION" in
    on)     do_on ;;
    off)    do_off ;;
    status) do_status ;;
    test)   do_test ;;
esac
