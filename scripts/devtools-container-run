#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  devtools-container-run [OPTIONS] IMAGE [-- COMMAND [ARG...]]

Options:
  -u, --user NAME       Runtime user name (default: admin)
      --uid UID         Runtime UID (default: id -u)
      --gid GID         Runtime GID (default: id -g)
  -w, --workspace PATH  Workspace to mount at /workspace (default: pwd)
      --ssh             Start sshd and publish host port 2222 to port 22
      --dry-run          Print docker command without executing it
  -h, --help            Show this help

The container entrypoint starts as root, reconciles the runtime user, then
drops privileges before running the requested command.
EOF
}

error() {
  echo "devtools-container-run: ERROR: $*" >&2
  exit 2
}

USER_NAME=admin
RUNTIME_UID="$(id -u)"
RUNTIME_GID="$(id -g)"
WORKSPACE="$PWD"
SSH_MODE=false
DRY_RUN=false
IMAGE=""
COMMAND=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -u|--user)
      [[ $# -ge 2 ]] || error "$1 requires a value"
      USER_NAME="$2"
      shift 2
      ;;
    --uid)
      [[ $# -ge 2 ]] || error "--uid requires a value"
      RUNTIME_UID="$2"
      shift 2
      ;;
    --gid)
      [[ $# -ge 2 ]] || error "--gid requires a value"
      RUNTIME_GID="$2"
      shift 2
      ;;
    -w|--workspace)
      [[ $# -ge 2 ]] || error "$1 requires a value"
      WORKSPACE="$2"
      shift 2
      ;;
    --ssh)
      SSH_MODE=true
      shift
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      COMMAND=("$@")
      break
      ;;
    -* )
      error "unknown option: $1"
      ;;
    *)
      if [[ -z "$IMAGE" ]]; then
        IMAGE="$1"
      else
        COMMAND+=("$1")
      fi
      shift
      ;;
  esac
done

[[ -n "$IMAGE" ]] || { usage >&2; error "IMAGE is required"; }
[[ -d "$WORKSPACE" ]] || error "workspace does not exist: ${WORKSPACE}"
[[ "$RUNTIME_UID" =~ ^[0-9]+$ ]] || error "invalid UID: ${RUNTIME_UID}"
[[ "$RUNTIME_GID" =~ ^[0-9]+$ ]] || error "invalid GID: ${RUNTIME_GID}"

DOCKER_ARGS=(
  run --rm --user root
  --env "DEV_USER=${USER_NAME}"
  --env "DEV_UID=${RUNTIME_UID}"
  --env "DEV_GID=${RUNTIME_GID}"
  --volume "${WORKSPACE}:/workspace"
)

if [[ -t 0 ]]; then
  DOCKER_ARGS+=(--interactive --tty)
else
  DOCKER_ARGS+=(--interactive)
fi

if [[ "$SSH_MODE" == true ]]; then
  DOCKER_ARGS+=(--publish 2222:22)
  COMMAND=(sshd)
fi

DOCKER_ARGS+=("$IMAGE")
if [[ ${#COMMAND[@]} -gt 0 ]]; then
  DOCKER_ARGS+=("${COMMAND[@]}")
fi

if [[ "$DRY_RUN" == true ]]; then
  printf 'docker'
  printf ' %q' "${DOCKER_ARGS[@]}"
  printf '\n'
  exit 0
fi

command -v docker >/dev/null 2>&1 || error "docker command not found"
exec docker "${DOCKER_ARGS[@]}"
