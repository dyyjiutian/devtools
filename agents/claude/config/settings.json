{
  "model": "sonnet",
  "effortLevel": "high",
  "theme": "dark",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-hud@claude-hud": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Agent"
    ],
    "ask": [
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(rm -f *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm * -r *)",
      "Bash(rm * -R *)",
      "Bash(rm * -f *)",
      "Bash(/bin/rm -r *)",
      "Bash(/bin/rm -R *)",
      "Bash(/bin/rm -f *)",
      "Bash(/bin/rm -rf *)",
      "Bash(/bin/rm -fr *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm *)",
      "Bash(unlink *)",
      "Bash(rmdir *)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D *)",
      "Bash(git push *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(ssh *)",
      "Bash(npm publish *)",
      "Bash(cargo publish *)",
      "Bash(docker push *)",
      "Bash(podman push *)",
      "Bash(ansible-playbook *)"
    ],
    "deny": [
      "Bash(rm *--no-preserve-root*)",
      "Bash(/bin/rm *--no-preserve-root*)",
      "Bash(sudo rm *--no-preserve-root*)",
      "Bash(rm -rf /)",
      "Bash(rm -fr /)",
      "Bash(/bin/rm -rf /)",
      "Bash(/bin/rm -fr /)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -fr /)",
      "Bash(rm -rf ~)",
      "Bash(rm -fr ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -fr ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -fr $HOME*)",
      "Bash(rm -rf ${HOME}*)",
      "Bash(rm -fr ${HOME}*)",
      "Bash(mkfs*)",
      "Bash(/sbin/mkfs*)",
      "Bash(sudo mkfs*)",
      "Bash(dd *of=/dev/*)",
      "Bash(sudo dd *of=/dev/*)",
      "Bash(diskutil eraseDisk *)",
      "Bash(diskutil eraseVolume *)",
      "Bash(diskutil partitionDisk *)",
      "Bash(diskutil zeroDisk *)",
      "Bash(diskutil secureErase *)",
      "Bash(fdisk *)",
      "Bash(parted *)"
    ]
  }
}
