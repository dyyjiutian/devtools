{
  "version": 1,
  "approvalMode": "allowlist",
  "sandbox": {
    "mode": "disabled",
    "networkAccess": "user_config_with_defaults"
  },
  "permissions": {
    "allow": [
      "Shell(*)",
      "Read(**)",
      "Write(**)",
      "WebFetch(*)",
      "Mcp(*)"
    ],
    "deny": [
      "Shell(rm)",
      "Shell(scp)",
      "Shell(sftp)",
      "Shell(rsync)",
      "Shell(curl)",
      "Shell(wget)",
      "Shell(nc)",
      "Shell(ncat)",
      "Shell(socat)"
    ]
  }
}
