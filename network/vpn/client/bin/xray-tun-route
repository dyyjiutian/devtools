#!/usr/bin/env bash
set -euo pipefail

IP_BIN="${IP_BIN:-ip}"
SYSCTL_BIN="${SYSCTL_BIN:-sysctl}"
SYSTEMCTL_BIN="${SYSTEMCTL_BIN:-systemctl}"
NFT_BIN="${NFT_BIN:-nft}"
IPTABLES_BIN="${IPTABLES_BIN:-iptables}"
IP6TABLES_BIN="${IP6TABLES_BIN:-ip6tables}"
TUN_IFACE="${XRAY_TUN_IFACE:-xray0}"
ROUTE_TABLE="${XRAY_TUN_TABLE:-1001}"
SOCKET_MARK="${XRAY_TUN_MARK:-255}"
MARK_RULE_PRIORITY="${XRAY_TUN_MARK_PRIORITY:-10000}"
BYPASS_RULE_PRIORITY="${XRAY_TUN_BYPASS_PRIORITY:-9990}"
TUN_RULE_PRIORITY="${XRAY_TUN_RULE_PRIORITY:-10010}"
MAX_LOCAL_UID=4294967294
STATE_FILE="${XRAY_TUN_STATE_FILE:-/run/xray-client-tun/rp-filter.state}"
UID_STATE_FILE="${XRAY_TUN_UID_STATE_FILE:-/run/xray-client-tun/bypass.uid}"
FIREWALL_STATE_FILE="${XRAY_TUN_FIREWALL_STATE_FILE:-/run/xray-client-tun/firewall.backend}"
NFT_TABLE="${XRAY_TUN_NFT_TABLE:-xray_client_tun}"
IPTABLES_PREROUTING_CHAIN="${XRAY_TUN_IPTABLES_PREROUTING_CHAIN:-XRAY_TUN_PREROUTING}"
IPTABLES_OUTPUT_CHAIN="${XRAY_TUN_IPTABLES_OUTPUT_CHAIN:-XRAY_TUN_OUTPUT}"
XRAY_SERVICE="${XRAY_TUN_SERVICE:-xray-client.service}"
BYPASS_UID="${XRAY_TUN_BYPASS_UID:-}"
FIREWALL_BACKEND=""
FIREWALL_FORCE_CLEANUP=false
NFT_CREATED=false
IPTABLES_V4_CREATED=false
IPTABLES_V6_CREATED=false
WAIT_ATTEMPTS="${XRAY_TUN_WAIT_ATTEMPTS:-50}"
WAIT_INTERVAL="${XRAY_TUN_WAIT_INTERVAL:-0.1}"

info() {
    echo "[xray-tun-route] $*"
}

warn() {
    echo "[xray-tun-route] WARN: $*" >&2
}

read_rp_filter() {
    "$SYSCTL_BIN" -n "$1" 2>/dev/null
}

set_rp_filter() {
    "$SYSCTL_BIN" -q -w "$1=$2"
}

prepare_rp_filter() {
    local all_key="net.ipv4.conf.all.rp_filter"
    local iface_key="net.ipv4.conf.${TUN_IFACE}.rp_filter"
    local old_all old_iface

    old_all="$(read_rp_filter "$all_key")" || return 1
    old_iface="$(read_rp_filter "$iface_key")" || return 1
    [[ "$old_all" =~ ^[0-2]$ && "$old_iface" =~ ^[0-2]$ ]] || {
        warn "无法识别当前 rp_filter 设置"
        return 1
    }

    if [[ ! -f "$STATE_FILE" ]]; then
        mkdir -p "$(dirname "$STATE_FILE")"
        chmod 0700 "$(dirname "$STATE_FILE")"
        (umask 077; printf '%s %s\n' "$old_all" "$old_iface" > "$STATE_FILE")
    fi

    set_rp_filter "$all_key" 0 || return 1
    set_rp_filter "$iface_key" 0 || return 1
}

restore_rp_filter() {
    [[ -f "$STATE_FILE" ]] || return 0

    local all_key="net.ipv4.conf.all.rp_filter"
    local iface_key="net.ipv4.conf.${TUN_IFACE}.rp_filter"
    local old_all old_iface current
    read -r old_all old_iface < "$STATE_FILE"

    current="$(read_rp_filter "$iface_key" 2>/dev/null || true)"
    if [[ "$current" == "0" ]]; then
        set_rp_filter "$iface_key" "$old_iface" || true
    elif [[ -n "$current" && "$current" != "$old_iface" ]]; then
        warn "${iface_key} 已被外部修改，保留当前值 ${current}"
    fi

    current="$(read_rp_filter "$all_key" 2>/dev/null || true)"
    if [[ "$current" == "0" ]]; then
        set_rp_filter "$all_key" "$old_all" || true
    elif [[ -n "$current" && "$current" != "$old_all" ]]; then
        warn "${all_key} 已被外部修改，保留当前值 ${current}"
    fi

    rm -f "$STATE_FILE"
}

wait_for_tun_iface() {
    local attempt
    for ((attempt = 1; attempt <= WAIT_ATTEMPTS; attempt++)); do
        if "$IP_BIN" link show dev "$TUN_IFACE" >/dev/null 2>&1; then
            return 0
        fi
        ((attempt < WAIT_ATTEMPTS)) && sleep "$WAIT_INTERVAL"
    done
    warn "等待 ${TUN_IFACE} 就绪超时"
    return 1
}

resolve_bypass_uid() {
    if [[ -z "$BYPASS_UID" ]]; then
        BYPASS_UID="$($SYSTEMCTL_BIN show "$XRAY_SERVICE" --property=UID --value 2>/dev/null || true)"
    fi
    [[ "$BYPASS_UID" =~ ^[0-9]+$ ]] || {
        warn "无法获取 ${XRAY_SERVICE} 的运行 UID"
        return 1
    }
}

load_bypass_uid_for_down() {
    if [[ -z "$BYPASS_UID" && -f "$UID_STATE_FILE" ]]; then
        read -r BYPASS_UID < "$UID_STATE_FILE"
    fi
    if [[ ! "$BYPASS_UID" =~ ^[0-9]+$ ]]; then
        BYPASS_UID="$($SYSTEMCTL_BIN show "$XRAY_SERVICE" --property=UID --value 2>/dev/null || true)"
    fi
    [[ "$BYPASS_UID" =~ ^[0-9]+$ ]]
}

save_bypass_uid() {
    mkdir -p "$(dirname "$UID_STATE_FILE")"
    chmod 0700 "$(dirname "$UID_STATE_FILE")"
    (umask 077; printf '%s\n' "$BYPASS_UID" > "$UID_STATE_FILE")
}

delete_bypass_rule() {
    local family="$1" uid="$2"
    "$IP_BIN" "$family" rule delete priority "$BYPASS_RULE_PRIORITY" \
        uidrange "${uid}-${uid}" lookup main 2>/dev/null || true
}

remove_stale_bypass_rules() {
    local old_uid=""
    [[ -f "$UID_STATE_FILE" ]] && read -r old_uid < "$UID_STATE_FILE"
    if [[ "$old_uid" =~ ^[0-9]+$ && "$old_uid" != "$BYPASS_UID" ]]; then
        delete_bypass_rule -4 "$old_uid"
        delete_bypass_rule -6 "$old_uid"
    fi
}

delete_rules() {
    local family="$1"
    if [[ "$BYPASS_UID" =~ ^[0-9]+$ ]]; then
        delete_bypass_rule "$family" "$BYPASS_UID"
    fi
    "$IP_BIN" "$family" rule delete priority "$MARK_RULE_PRIORITY" \
        fwmark "$SOCKET_MARK" lookup main 2>/dev/null || true
    "$IP_BIN" "$family" rule delete priority "$TUN_RULE_PRIORITY" \
        uidrange "0-${MAX_LOCAL_UID}" lookup "$ROUTE_TABLE" 2>/dev/null || true
}

ensure_rule_slot() {
    local family="$1" priority="$2" expected_regex="$3"
    local line
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*${priority}: ]] || continue
        if [[ ! "$line" =~ $expected_regex ]]; then
            warn "策略规则优先级 ${priority} 已被占用: ${line}"
            return 1
        fi
    done < <("$IP_BIN" "$family" rule show 2>/dev/null)
}

ensure_route_table_available() {
    local family="$1" line
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        if [[ ! "$line" =~ ^default[[:space:]].*dev[[:space:]]${TUN_IFACE}([[:space:]]|$) ]]; then
            warn "路由表 ${ROUTE_TABLE} 已包含非本工具管理的默认路由: ${line}"
            return 1
        fi
    done < <("$IP_BIN" "$family" route show table "$ROUTE_TABLE" default 2>/dev/null)
}

ensure_family_available() {
    local family="$1"
    ensure_rule_slot "$family" "$BYPASS_RULE_PRIORITY" \
        "uidrange[[:space:]]+${BYPASS_UID}-${BYPASS_UID}.*lookup[[:space:]]+main" || return 1
    ensure_rule_slot "$family" "$MARK_RULE_PRIORITY" \
        'fwmark[[:space:]]+(0xff|255).*lookup[[:space:]]+main' || return 1
    ensure_rule_slot "$family" "$TUN_RULE_PRIORITY" \
        "uidrange[[:space:]]+0-${MAX_LOCAL_UID}.*lookup[[:space:]]+${ROUTE_TABLE}" || return 1
    ensure_route_table_available "$family"
}

up_family() {
    local family="$1"
    ensure_family_available "$family" || return 1
    delete_rules "$family"
    "$IP_BIN" "$family" route replace default dev "$TUN_IFACE" table "$ROUTE_TABLE" \
        || return 1
    if ! "$IP_BIN" "$family" rule add priority "$BYPASS_RULE_PRIORITY" \
        uidrange "${BYPASS_UID}-${BYPASS_UID}" lookup main; then
        down_family "$family"
        return 1
    fi
    if ! "$IP_BIN" "$family" rule add priority "$MARK_RULE_PRIORITY" \
        fwmark "$SOCKET_MARK" lookup main; then
        down_family "$family"
        return 1
    fi
    if ! "$IP_BIN" "$family" rule add priority "$TUN_RULE_PRIORITY" \
        uidrange "0-${MAX_LOCAL_UID}" lookup "$ROUTE_TABLE"; then
        down_family "$family"
        return 1
    fi
}

down_family() {
    local family="$1"
    delete_rules "$family"
    "$IP_BIN" "$family" route delete default dev "$TUN_IFACE" table "$ROUTE_TABLE" \
        2>/dev/null || true
}

command_available() {
    command -v "$1" >/dev/null 2>&1
}

detect_firewall_backend() {
    if command_available "$NFT_BIN" && "$NFT_BIN" --version >/dev/null 2>&1; then
        printf '%s\n' nft
        return 0
    fi
    if command_available "$IPTABLES_BIN" && command_available "$IP6TABLES_BIN"; then
        printf '%s\n' iptables
        return 0
    fi
    warn "未找到可用的 nftables 或 iptables/ip6tables，拒绝启用 TUN"
    return 1
}

save_firewall_backend() {
    mkdir -p "$(dirname "$FIREWALL_STATE_FILE")"
    chmod 0700 "$(dirname "$FIREWALL_STATE_FILE")"
    (umask 077; printf '%s\n' "$FIREWALL_BACKEND" > "$FIREWALL_STATE_FILE")
}

load_firewall_backend() {
    if [[ -z "$FIREWALL_BACKEND" && -f "$FIREWALL_STATE_FILE" ]]; then
        read -r FIREWALL_BACKEND < "$FIREWALL_STATE_FILE"
        FIREWALL_FORCE_CLEANUP=true
        [[ "$FIREWALL_BACKEND" == nft ]] && NFT_CREATED=true
        [[ "$FIREWALL_BACKEND" == iptables ]] && {
            IPTABLES_V4_CREATED=true
            IPTABLES_V6_CREATED=true
        }
    fi
    [[ "$FIREWALL_BACKEND" == nft || "$FIREWALL_BACKEND" == iptables ]]
}

nft_firewall_down() {
    if $NFT_CREATED || $FIREWALL_FORCE_CLEANUP; then
        "$NFT_BIN" delete table inet "$NFT_TABLE" 2>/dev/null || true
    fi
    NFT_CREATED=false
}

nft_firewall_up() {
    if "$NFT_BIN" list table inet "$NFT_TABLE" >/dev/null 2>&1; then
        warn "nftables 表 ${NFT_TABLE} 已存在，拒绝覆盖非本工具状态"
        return 1
    fi
    "$NFT_BIN" add table inet "$NFT_TABLE" || return 1
    NFT_CREATED=true
    "$NFT_BIN" add chain inet "$NFT_TABLE" prerouting \
        '{ type filter hook prerouting priority mangle; policy accept; }' || return 1
    "$NFT_BIN" add chain inet "$NFT_TABLE" output \
        '{ type route hook output priority mangle; policy accept; }' || return 1
    "$NFT_BIN" add rule inet "$NFT_TABLE" prerouting \
        iifname "$TUN_IFACE" return || return 1
    "$NFT_BIN" add rule inet "$NFT_TABLE" prerouting \
        iifname '!=' "$TUN_IFACE" ct state new ct mark 0 \
        ct mark set "$SOCKET_MARK" meta mark set "$SOCKET_MARK" || return 1
    "$NFT_BIN" add rule inet "$NFT_TABLE" output \
        ct mark "$SOCKET_MARK" meta mark set "$SOCKET_MARK" || return 1
    "$NFT_BIN" add rule inet "$NFT_TABLE" output \
        ip protocol icmp icmp type echo-reply meta mark set "$SOCKET_MARK" || return 1
    "$NFT_BIN" add rule inet "$NFT_TABLE" output \
        ip6 nexthdr icmpv6 icmpv6 type echo-reply \
        meta mark set "$SOCKET_MARK" || return 1
    "$NFT_BIN" list table inet "$NFT_TABLE" >/dev/null || return 1
}

iptables_firewall_up_family() {
    local firewall_bin="$1" family="$2"
    if "$firewall_bin" -t mangle -L "$IPTABLES_PREROUTING_CHAIN" -n \
        >/dev/null 2>&1 || "$firewall_bin" -t mangle -L "$IPTABLES_OUTPUT_CHAIN" -n \
        >/dev/null 2>&1; then
        warn "iptables 链已存在，拒绝覆盖非本工具状态"
        return 1
    fi
    "$firewall_bin" -t mangle -N "$IPTABLES_PREROUTING_CHAIN" || return 1
    "$firewall_bin" -t mangle -N "$IPTABLES_OUTPUT_CHAIN" || return 1
    if [[ "$family" == 4 ]]; then
        IPTABLES_V4_CREATED=true
    else
        IPTABLES_V6_CREATED=true
    fi
    "$firewall_bin" -t mangle -A PREROUTING -j "$IPTABLES_PREROUTING_CHAIN" || return 1
    "$firewall_bin" -t mangle -A OUTPUT -j "$IPTABLES_OUTPUT_CHAIN" || return 1
    "$firewall_bin" -t mangle -A "$IPTABLES_PREROUTING_CHAIN" \
        -i "$TUN_IFACE" -j RETURN || return 1
    "$firewall_bin" -t mangle -A "$IPTABLES_PREROUTING_CHAIN" \
        -m conntrack --ctstate NEW -m connmark --mark 0 \
        -j CONNMARK --set-mark "$SOCKET_MARK" || return 1
    "$firewall_bin" -t mangle -A "$IPTABLES_OUTPUT_CHAIN" \
        -m connmark --mark "$SOCKET_MARK" \
        -j MARK --set-mark "$SOCKET_MARK" || return 1
    if [[ "$family" == 4 ]]; then
        "$firewall_bin" -t mangle -A "$IPTABLES_OUTPUT_CHAIN" \
            -p icmp --icmp-type echo-reply \
            -j MARK --set-mark "$SOCKET_MARK" || return 1
    else
        "$firewall_bin" -t mangle -A "$IPTABLES_OUTPUT_CHAIN" \
            -p ipv6-icmp --icmpv6-type echo-reply \
            -j MARK --set-mark "$SOCKET_MARK" || return 1
    fi
}

iptables_firewall_down_family() {
    local firewall_bin="$1" family="$2" should_cleanup=false
    if [[ "$family" == 4 && "$IPTABLES_V4_CREATED" == true ]] \
        || [[ "$family" == 6 && "$IPTABLES_V6_CREATED" == true ]]; then
        should_cleanup=true
    fi
    $should_cleanup || return 0
    "$firewall_bin" -t mangle -D PREROUTING -j "$IPTABLES_PREROUTING_CHAIN" \
        2>/dev/null || true
    "$firewall_bin" -t mangle -D OUTPUT -j "$IPTABLES_OUTPUT_CHAIN" \
        2>/dev/null || true
    "$firewall_bin" -t mangle -F "$IPTABLES_PREROUTING_CHAIN" \
        2>/dev/null || true
    "$firewall_bin" -t mangle -F "$IPTABLES_OUTPUT_CHAIN" \
        2>/dev/null || true
    "$firewall_bin" -t mangle -X "$IPTABLES_PREROUTING_CHAIN" \
        2>/dev/null || true
    "$firewall_bin" -t mangle -X "$IPTABLES_OUTPUT_CHAIN" \
        2>/dev/null || true
    if [[ "$family" == 4 ]]; then
        IPTABLES_V4_CREATED=false
    else
        IPTABLES_V6_CREATED=false
    fi
}

iptables_firewall_down() {
    iptables_firewall_down_family "$IPTABLES_BIN" 4
    iptables_firewall_down_family "$IP6TABLES_BIN" 6
}

firewall_down() {
    load_firewall_backend || true
    case "$FIREWALL_BACKEND" in
        nft)       nft_firewall_down ;;
        iptables)  iptables_firewall_down ;;
    esac
    rm -f "$FIREWALL_STATE_FILE"
    FIREWALL_BACKEND=""
    FIREWALL_FORCE_CLEANUP=false
}

firewall_up() {
    firewall_down
    FIREWALL_BACKEND="$(detect_firewall_backend)"
    case "$FIREWALL_BACKEND" in
        nft)
            if ! nft_firewall_up; then
                nft_firewall_down
                FIREWALL_BACKEND=""
                return 1
            fi
            ;;
        iptables)
            if ! iptables_firewall_up_family "$IPTABLES_BIN" 4 \
                || ! iptables_firewall_up_family "$IP6TABLES_BIN" 6; then
                iptables_firewall_down
                FIREWALL_BACKEND=""
                return 1
            fi
            ;;
        *)
            return 1
            ;;
    esac
    save_firewall_backend
    info "已启用 ${FIREWALL_BACKEND} 入站连接回包保护"
}

routes_up() {
    wait_for_tun_iface
    resolve_bypass_uid
    remove_stale_bypass_rules
    save_bypass_uid
    if ! prepare_rp_filter; then
        restore_rp_filter
        return 1
    fi
    if ! firewall_up; then
        restore_rp_filter
        return 1
    fi
    if ! up_family -4; then
        firewall_down
        restore_rp_filter
        return 1
    fi
    if ! up_family -6; then
        warn "IPv6 策略路由不可用，继续使用 IPv4 TUN"
        down_family -6
    fi
    info "已启用 ${TUN_IFACE} 宿主机策略路由"
}

routes_down() {
    load_bypass_uid_for_down || warn "无法定位 Xray UID，仅清理 mark 和 TUN 规则"
    down_family -4
    down_family -6
    firewall_down
    restore_rp_filter
    rm -f "$UID_STATE_FILE"
    info "已移除 ${TUN_IFACE} 宿主机策略路由"
}

routes_status() {
    "$IP_BIN" link show dev "$TUN_IFACE" 2>/dev/null || true
    "$IP_BIN" -4 rule show 2>/dev/null | grep -E \
        "(^|[[:space:]])(${BYPASS_RULE_PRIORITY}|${MARK_RULE_PRIORITY}|${TUN_RULE_PRIORITY}):" || true
    "$IP_BIN" -4 route show table "$ROUTE_TABLE" 2>/dev/null || true
    "$IP_BIN" -6 rule show 2>/dev/null | grep -E \
        "(^|[[:space:]])(${BYPASS_RULE_PRIORITY}|${MARK_RULE_PRIORITY}|${TUN_RULE_PRIORITY}):" || true
    "$IP_BIN" -6 route show table "$ROUTE_TABLE" 2>/dev/null || true
    if load_firewall_backend; then
        echo "[xray-tun-route] firewall backend: ${FIREWALL_BACKEND}"
    fi
}

case "${1:-}" in
    up)     routes_up ;;
    down)   routes_down ;;
    status) routes_status ;;
    *)
        echo "用法: $0 up | down | status" >&2
        exit 2
        ;;
esac
