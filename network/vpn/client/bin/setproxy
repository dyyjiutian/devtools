#!/usr/bin/env bash
# setproxy: 轻量级 VPN 终端代理开关（on / off / status / test）
#
# 支持 macOS / Linux，自动识别常见本地代理端口：
#   macOS V2RayXS: HTTP 8001 / SOCKS 1081
#   Xray CLI:     HTTP 10809 / SOCKS 10808
#
# 当前 shell 立即生效：
#   source setproxy on
#   eval "$(setproxy on --emit)"
#
# Git SSH 地址走 SOCKS：
#   setproxy on --git-ssh 导出 GIT_SSH_COMMAND，通过 nc 连接 SOCKS5。
#   默认不修改 Git SSH 行为，也不会修改 ~/.ssh/config。

set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; BOLD='\033[1m'; RESET='\033[0m'

ACTION=""
EMIT=false
CLI_HTTP_HOST=""
CLI_HTTP_PORT=""
CLI_SOCKS_HOST=""
CLI_SOCKS_PORT=""
CLI_GIT_SSH_PROXY=""
DOCKER_DAEMON=false
DNF_PROXY=false
CLI_TEST_SIZE_MB=""

usage() {
    cat <<'HELP'
用法: setproxy on | off | status | test [选项]

  on      开启终端代理，写入 ~/.config/vpn/proxy.env
  off     关闭终端代理
  status  查看代理配置、环境变量和本地端口
  test    测试常用站点连通性及国内/海外下载速度（默认测速 10MB）

选项:
  --emit                 仅向标准输出打印可供 eval 执行的 shell 代码
  --http-host HOST       指定 HTTP 代理主机
  --http-port PORT       指定 HTTP 代理端口
  --socks-host HOST      指定 SOCKS5 代理主机
  --socks-port PORT      指定 SOCKS5 代理端口
  --no-git-ssh           不为 Git SSH 导出 GIT_SSH_COMMAND（默认）
  --git-ssh              为本次命令的 Git SSH 导出 GIT_SSH_COMMAND
  --docker-daemon        为本次 on 配置 Docker 守护进程代理
  --dnf-proxy            为本次 on 配置 dnf 下载代理
  --size MB              仅 test：测速大小，范围 1-1000 MB（默认 10）
  -h, --help             显示帮助

配置优先级:
  命令行参数 > VPN_* 环境变量 > ~/.config/vpn/setproxy.conf
  > 已监听端口自动识别 > 操作系统默认值

环境变量:
  VPN_HTTP_HOST / VPN_HTTP_PORT
  VPN_SOCKS_HOST / VPN_SOCKS_PORT
  VPN_GIT_SSH_PROXY=true|false
HELP
}

emit_mode_log() {
    if $EMIT; then
        echo -e "$*" >&2
    else
        echo -e "$*"
    fi
}

info()    { emit_mode_log "${BLUE}[INFO]${RESET}  $*"; }
success() { emit_mode_log "${GREEN}[OK]${RESET}    $*"; }
warn()    { echo -e "${YELLOW}[WARN]${RESET}  $*" >&2; }
error()   { echo -e "${RED}[ERROR]${RESET} $*" >&2; }

need_value() {
    local option="$1" value="${2:-}"
    if [[ -z "$value" ]]; then
        error "${option} 缺少参数"
        exit 1
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        on|off|status|test)
            if [[ -n "$ACTION" && "$ACTION" != "$1" ]]; then
                error "只能指定一个操作"
                exit 1
            fi
            ACTION="$1"
            shift
            ;;
        --emit)
            EMIT=true
            shift
            ;;
        --http-host=*)  CLI_HTTP_HOST="${1#*=}"; shift ;;
        --http-port=*)  CLI_HTTP_PORT="${1#*=}"; shift ;;
        --socks-host=*) CLI_SOCKS_HOST="${1#*=}"; shift ;;
        --socks-port=*) CLI_SOCKS_PORT="${1#*=}"; shift ;;
        --size=*)       CLI_TEST_SIZE_MB="${1#*=}"; shift ;;
        --http-host|--http-port|--socks-host|--socks-port|--size)
            option="$1"
            shift
            need_value "$option" "${1:-}"
            case "$option" in
                --http-host)  CLI_HTTP_HOST="$1" ;;
                --http-port)  CLI_HTTP_PORT="$1" ;;
                --socks-host) CLI_SOCKS_HOST="$1" ;;
                --socks-port) CLI_SOCKS_PORT="$1" ;;
                --size)       CLI_TEST_SIZE_MB="$1" ;;
            esac
            shift
            ;;
        --no-git-ssh)
            CLI_GIT_SSH_PROXY=false
            shift
            ;;
        --git-ssh)
            CLI_GIT_SSH_PROXY=true
            shift
            ;;
        --docker-daemon)
            DOCKER_DAEMON=true
            shift
            ;;
        --dnf-proxy)
            DNF_PROXY=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            error "未知参数: $1"
            usage >&2
            exit 1
            ;;
    esac
done

if [[ -z "$ACTION" ]]; then
    usage
    exit 1
fi

PROXY_DIR="${HOME}/.config/vpn"
PROXY_ENV="${PROXY_DIR}/proxy.env"
CONFIG_FILE="${PROXY_DIR}/setproxy.conf"
DOCKER_STATE_FILE="${PROXY_DIR}/setproxy-docker-state.json"
DNF_STATE_FILE="${PROXY_DIR}/setproxy-dnf-state.json"
DNF_CONF="${VPN_DNF_CONF:-/etc/dnf/dnf.conf}"
DOCKER_DAEMON_JSON="${VPN_DOCKER_DAEMON_JSON:-/etc/docker/daemon.json}"
MARKER_BEGIN="# >>> vpn-shell-proxy managed >>>"
MARKER_END="# <<< vpn-shell-proxy managed <<<"
HOOK_LINE='[ -f "${HOME}/.config/vpn/proxy.env" ] && . "${HOME}/.config/vpn/proxy.env"'

IS_DARWIN=false
[[ "$(uname)" == "Darwin" ]] && IS_DARWIN=true

port_listening() {
    local port="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -tln 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]${port}$"
    elif command -v lsof >/dev/null 2>&1; then
        lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1
    else
        return 1
    fi
}

CONFIG_HTTP_HOST=""
CONFIG_HTTP_PORT=""
CONFIG_SOCKS_HOST=""
CONFIG_SOCKS_PORT=""

load_config() {
    [[ -f "$CONFIG_FILE" ]] || return 0
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
}

first_nonempty() {
    local value
    for value in "$@"; do
        if [[ -n "$value" ]]; then
            printf '%s' "$value"
            return 0
        fi
    done
}

detect_default_ports() {
    DETECTED_HTTP_PORT=""
    DETECTED_SOCKS_PORT=""

    if $IS_DARWIN; then
        if port_listening 8001 && port_listening 1081; then
            DETECTED_HTTP_PORT=8001
            DETECTED_SOCKS_PORT=1081
        elif port_listening 10809 && port_listening 10808; then
            DETECTED_HTTP_PORT=10809
            DETECTED_SOCKS_PORT=10808
        elif port_listening 8001 || port_listening 1081; then
            DETECTED_HTTP_PORT=8001
            DETECTED_SOCKS_PORT=1081
        elif port_listening 10809 || port_listening 10808; then
            DETECTED_HTTP_PORT=10809
            DETECTED_SOCKS_PORT=10808
        else
            DETECTED_HTTP_PORT=8001
            DETECTED_SOCKS_PORT=1081
        fi
    else
        if port_listening 10809 && port_listening 10808; then
            DETECTED_HTTP_PORT=10809
            DETECTED_SOCKS_PORT=10808
        elif port_listening 8001 && port_listening 1081; then
            DETECTED_HTTP_PORT=8001
            DETECTED_SOCKS_PORT=1081
        elif port_listening 10809 || port_listening 10808; then
            DETECTED_HTTP_PORT=10809
            DETECTED_SOCKS_PORT=10808
        elif port_listening 8001 || port_listening 1081; then
            DETECTED_HTTP_PORT=8001
            DETECTED_SOCKS_PORT=1081
        else
            DETECTED_HTTP_PORT=10809
            DETECTED_SOCKS_PORT=10808
        fi
    fi
}

validate_host() {
    local label="$1" value="$2"
    if [[ ! "$value" =~ ^[A-Za-z0-9._:-]+$ ]]; then
        error "${label} 包含不支持的字符: ${value}"
        exit 1
    fi
}

validate_port() {
    local label="$1" value="$2"
    if [[ ! "$value" =~ ^[0-9]+$ ]] || (( value < 1 || value > 65535 )); then
        error "${label} 必须是 1-65535 的端口号: ${value}"
        exit 1
    fi
}

validate_size() {
    local value="$1"
    if [[ ! "$value" =~ ^[0-9]+$ ]] \
        || (( 10#$value < 1 || 10#$value > 1000 )); then
        error "测速大小必须是 1-1000 的整数 MB: ${value}"
        exit 1
    fi
}

normalize_bool() {
    case "${1:-}" in
        true|TRUE|yes|YES|1|on|ON) printf 'true' ;;
        false|FALSE|no|NO|0|off|OFF) printf 'false' ;;
        *)
            error "VPN_GIT_SSH_PROXY 只能是 true 或 false"
            exit 1
            ;;
    esac
}

load_config
detect_default_ports

HTTP_HOST="$(first_nonempty "$CLI_HTTP_HOST" "${VPN_HTTP_HOST:-}" "$CONFIG_HTTP_HOST" "127.0.0.1")"
HTTP_PORT="$(first_nonempty "$CLI_HTTP_PORT" "${VPN_HTTP_PORT:-}" "$CONFIG_HTTP_PORT" "$DETECTED_HTTP_PORT")"
SOCKS_HOST="$(first_nonempty "$CLI_SOCKS_HOST" "${VPN_SOCKS_HOST:-}" "$CONFIG_SOCKS_HOST" "127.0.0.1")"
SOCKS_PORT="$(first_nonempty "$CLI_SOCKS_PORT" "${VPN_SOCKS_PORT:-}" "$CONFIG_SOCKS_PORT" "$DETECTED_SOCKS_PORT")"
GIT_SSH_PROXY="$(normalize_bool "$(first_nonempty "$CLI_GIT_SSH_PROXY" "${VPN_GIT_SSH_PROXY:-}" "false")")"
TEST_SIZE_MB="${CLI_TEST_SIZE_MB:-10}"

validate_host "HTTP 代理主机" "$HTTP_HOST"
validate_host "SOCKS 代理主机" "$SOCKS_HOST"
validate_port "HTTP 代理端口" "$HTTP_PORT"
validate_port "SOCKS 代理端口" "$SOCKS_PORT"
if [[ -n "$CLI_TEST_SIZE_MB" && "$ACTION" != "test" ]]; then
    error "--size 仅可与 test 一起使用"
    exit 1
fi
validate_size "$TEST_SIZE_MB"

ensure_shell_hook() {
    local rc="$1"
    [[ -f "$rc" ]] || return 0
    grep -qF "$MARKER_BEGIN" "$rc" 2>/dev/null && return 0
    {
        echo ""
        echo "$MARKER_BEGIN"
        echo "$HOOK_LINE"
        echo "$MARKER_END"
    } >> "$rc"
    info "已写入 shell 钩子: ${rc}"
}

write_config() {
    mkdir -p "$PROXY_DIR"
    {
        echo "# setproxy configuration — managed by setproxy"
        printf 'CONFIG_HTTP_HOST="%s"\n' "$HTTP_HOST"
        printf 'CONFIG_HTTP_PORT="%s"\n' "$HTTP_PORT"
        printf 'CONFIG_SOCKS_HOST="%s"\n' "$SOCKS_HOST"
        printf 'CONFIG_SOCKS_PORT="%s"\n' "$SOCKS_PORT"
    } > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
}

dnf_available() {
    ! $IS_DARWIN && command -v dnf >/dev/null 2>&1
}

configure_dnf_proxy_on() {
    dnf_available || return 0

    local proxy_url="http://${HTTP_HOST}:${HTTP_PORT}"
    if ! sudo python3 - "$DNF_CONF" "$DNF_STATE_FILE" "$proxy_url" <<'PY'
import json
import os
import re
import stat
import sys
import tempfile

config_path, state_path, proxy_url = sys.argv[1:]
section_pattern = re.compile(r"^\s*\[([^]]+)\]\s*(?:[;#].*)?$")
proxy_pattern = re.compile(r"^\s*proxy\s*=", re.IGNORECASE)

def read_text(path):
    try:
        with open(path, encoding="utf-8") as source:
            return source.read()
    except FileNotFoundError:
        return ""

def write_atomically(path, content, mode=None):
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    fd, temporary_path = tempfile.mkstemp(prefix=".setproxy-dnf-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as destination:
            destination.write(content)
        if mode is not None:
            os.chmod(temporary_path, mode)
        os.replace(temporary_path, path)
    except BaseException:
        os.unlink(temporary_path)
        raise

def find_main(lines):
    for index, line in enumerate(lines):
        match = section_pattern.match(line)
        if match and match.group(1).strip().lower() == "main":
            for end in range(index + 1, len(lines)):
                if section_pattern.match(lines[end]):
                    return index, end
            return index, len(lines)
    return None

def proxy_lines(lines, bounds):
    if bounds is None:
        return []
    start, end = bounds
    return [line for line in lines[start + 1:end] if proxy_pattern.match(line)]

def proxy_values(lines, bounds):
    return [line.split("=", 1)[1].strip() for line in proxy_lines(lines, bounds)]

def replace_proxy(lines, value):
    bounds = find_main(lines)
    if bounds is None:
        suffix = "" if not lines or lines[-1].endswith("\n") else "\n"
        return lines + ([suffix] if suffix else []) + ["[main]\n", f"proxy={value}\n"]
    start, end = bounds
    body = [line for line in lines[start + 1:end] if not proxy_pattern.match(line)]
    return lines[:start + 1] + [f"proxy={value}\n"] + body + lines[end:]

config = read_text(config_path)
lines = config.splitlines(keepends=True)
bounds = find_main(lines)

try:
    with open(state_path, encoding="utf-8") as source:
        state_data = json.load(source)
except FileNotFoundError:
    state_data = None

if state_data is None:
    state_data = {
        "main_existed": bounds is not None,
        "original_proxy_lines": proxy_lines(lines, bounds),
        "applied": proxy_url,
    }
else:
    if not isinstance(state_data, dict) or not isinstance(state_data.get("applied"), str):
        raise ValueError("dnf 代理状态文件格式无效")
    if proxy_values(lines, bounds) != [state_data["applied"]]:
        print("dnf 代理配置已被其他工具修改，未覆盖现有配置", file=sys.stderr)
        sys.exit(4)
    state_data["applied"] = proxy_url

config_mode = stat.S_IMODE(os.stat(config_path).st_mode) if os.path.exists(config_path) else 0o644
write_atomically(config_path, "".join(replace_proxy(lines, proxy_url)), config_mode)
write_atomically(state_path, json.dumps(state_data, indent=2, sort_keys=True) + "\n", 0o600)
PY
    then
        error "无法写入 dnf 代理配置: ${DNF_CONF}"
        return 1
    fi
    info "dnf 代理已写入 ${DNF_CONF}；需要 sudo 权限"
}

configure_dnf_proxy_off() {
    dnf_available || return 0

    local status
    if sudo python3 - "$DNF_CONF" "$DNF_STATE_FILE" <<'PY'
import json
import os
import re
import stat
import sys
import tempfile

config_path, state_path = sys.argv[1:]
section_pattern = re.compile(r"^\s*\[([^]]+)\]\s*(?:[;#].*)?$")
proxy_pattern = re.compile(r"^\s*proxy\s*=", re.IGNORECASE)

if not os.path.exists(state_path):
    sys.exit(3)

with open(state_path, encoding="utf-8") as source:
    state_data = json.load(source)
if not isinstance(state_data, dict) or not isinstance(state_data.get("applied"), str):
    raise ValueError("dnf 代理状态文件格式无效")
if not os.path.exists(config_path):
    print("dnf 配置文件不存在，未使用过期状态恢复", file=sys.stderr)
    sys.exit(4)

with open(config_path, encoding="utf-8") as source:
    lines = source.read().splitlines(keepends=True)

def find_main(items):
    for index, line in enumerate(items):
        match = section_pattern.match(line)
        if match and match.group(1).strip().lower() == "main":
            for end in range(index + 1, len(items)):
                if section_pattern.match(items[end]):
                    return index, end
            return index, len(items)
    return None

bounds = find_main(lines)
if bounds is None:
    current_values = []
else:
    start, end = bounds
    current_values = [line.split("=", 1)[1].strip() for line in lines[start + 1:end] if proxy_pattern.match(line)]

if current_values != [state_data["applied"]]:
    print("dnf 代理配置已被其他工具修改，未使用过期备份恢复", file=sys.stderr)
    sys.exit(4)

start, end = bounds
body = [line for line in lines[start + 1:end] if not proxy_pattern.match(line)]
original = state_data.get("original_proxy_lines", [])
if not isinstance(original, list) or not all(isinstance(line, str) for line in original):
    raise ValueError("dnf 代理状态文件格式无效")
restored = lines[:start + 1] + original + body + lines[end:]
if not state_data.get("main_existed") and not body and not original:
    restored = lines[:start] + lines[end:]

directory = os.path.dirname(config_path) or "."
fd, temporary_path = tempfile.mkstemp(prefix=".setproxy-dnf-", dir=directory)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as destination:
        destination.write("".join(restored))
    os.chmod(temporary_path, stat.S_IMODE(os.stat(config_path).st_mode))
    os.replace(temporary_path, config_path)
except BaseException:
    os.unlink(temporary_path)
    raise
os.unlink(state_path)
PY
    then
        info "dnf 代理已恢复: ${DNF_CONF}"
        return 0
    fi

    status=$?
    case "$status" in
        3) return 0 ;;
        4)
            warn "dnf 代理配置已被其他工具修改，未使用过期备份恢复"
            return 0
            ;;
        *)
            error "无法恢复 dnf 代理配置: ${DNF_CONF}"
            return "$status"
            ;;
    esac
}

detect_docker_target() {
    DOCKER_TARGET_KIND=""
    DOCKER_TARGET_NAME=""

    if $IS_DARWIN; then
        local colima_status=""
        if command -v colima >/dev/null 2>&1; then
            colima_status="$(colima status 2>/dev/null || true)"
            if grep -Eqi 'runtime[[:space:]]*:[[:space:]]*docker' <<< "$colima_status"; then
                DOCKER_TARGET_KIND="colima"
                DOCKER_TARGET_NAME="colima:${COLIMA_PROFILE:-default}"
                return 0
            fi
        fi
        if command -v docker >/dev/null 2>&1 \
            && [[ "$(docker context show 2>/dev/null || true)" == desktop-* ]]; then
            DOCKER_TARGET_KIND="desktop"
            DOCKER_TARGET_NAME="docker-desktop"
        fi
    elif command -v docker >/dev/null 2>&1; then
        DOCKER_TARGET_KIND="linux"
        DOCKER_TARGET_NAME="linux"
    fi
}

read_linux_docker_config() {
    sudo cat "$DOCKER_DAEMON_JSON" 2>/dev/null || printf '{}\n'
}

write_linux_docker_config() {
    local content="$1"
    sudo mkdir -p "$(dirname "$DOCKER_DAEMON_JSON")" \
        && printf '%s\n' "$content" | sudo tee "$DOCKER_DAEMON_JSON" >/dev/null
}

read_colima_docker_config() {
    colima ssh -- sudo cat /etc/docker/daemon.json 2>/dev/null || printf '{}\n'
}

write_colima_docker_config() {
    local content="$1"
    printf '%s\n' "$content" | colima ssh -- sudo tee /etc/docker/daemon.json >/dev/null
}

transform_docker_config() {
    local action="$1" target="$2" proxy_url="$3" config="$4"
    local config_input status output
    config_input="$(mktemp "${TMPDIR:-/tmp}/setproxy-docker.XXXXXX")" || return 1
    printf '%s\n' "$config" > "$config_input"

    if output="$(python3 - "$action" "$target" "$DOCKER_STATE_FILE" "$proxy_url" "$config_input" <<'PY'
import json
import os
import sys
import tempfile

action, target, state_path, proxy_url, config_path = sys.argv[1:]

with open(config_path, encoding="utf-8") as config_file:
    config = json.load(config_file)
if not isinstance(config, dict):
    raise ValueError("daemon.json 根节点必须是对象")

try:
    with open(state_path, encoding="utf-8") as state_file:
        state = json.load(state_file)
except FileNotFoundError:
    state = {"targets": {}}

if not isinstance(state, dict) or not isinstance(state.get("targets", {}), dict):
    raise ValueError("Docker 代理状态文件格式无效")
targets = state.setdefault("targets", {})

def write_state():
    directory = os.path.dirname(state_path)
    if directory:
        os.makedirs(directory, mode=0o700, exist_ok=True)
    fd, temporary_path = tempfile.mkstemp(prefix=".setproxy-docker-", dir=directory or None)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as state_file:
            json.dump(state, state_file, indent=2, sort_keys=True)
            state_file.write("\n")
        os.chmod(temporary_path, 0o600)
        os.replace(temporary_path, state_path)
    except BaseException:
        os.unlink(temporary_path)
        raise

if action == "apply":
    applied = {
        "http-proxy": proxy_url,
        "https-proxy": proxy_url,
        "no-proxy": "127.0.0.1,localhost,::1",
    }
    targets[target] = {
        "previous_exists": "proxies" in config,
        "previous": config.get("proxies"),
        "applied": applied,
    }
    config["proxies"] = applied
    write_state()
elif action == "restore":
    saved = targets.get(target)
    if saved is None:
        sys.exit(3)
    if config.get("proxies") != saved.get("applied"):
        sys.exit(4)
    if saved.get("previous_exists"):
        config["proxies"] = saved.get("previous")
    else:
        config.pop("proxies", None)
    targets.pop(target)
    if targets:
        write_state()
    elif os.path.exists(state_path):
        os.unlink(state_path)
else:
    raise ValueError("未知 Docker 配置操作")

print(json.dumps(config, indent=2, sort_keys=True))
PY
)"; then
        rm -f "$config_input"
        printf '%s' "$output"
        return 0
    else
        status=$?
        rm -f "$config_input"
        return "$status"
    fi
}

configure_docker_target() {
    local action="$1" target="$2" proxy_url="$3" current updated status
    case "$DOCKER_TARGET_KIND" in
        linux) current="$(read_linux_docker_config)" ;;
        colima) current="$(read_colima_docker_config)" ;;
        *) return 0 ;;
    esac

    if updated="$(transform_docker_config "$action" "$target" "$proxy_url" "$current")"; then
        :
    else
        status=$?
        case "$status" in
            3) return 0 ;;
            4)
                warn "Docker 代理配置已被其他工具修改，未使用过期备份恢复: ${target}"
                return 0
                ;;
            *)
                warn "无法处理 Docker 守护进程配置: ${target}"
                return 0
                ;;
        esac
    fi

    case "$DOCKER_TARGET_KIND" in
        linux)
            if ! write_linux_docker_config "$updated"; then
                warn "无法写入 ${DOCKER_DAEMON_JSON}；终端代理已保持启用"
                return 0
            fi
            if [[ "$action" == "apply" ]]; then
                info "Docker 守护进程代理已写入 ${DOCKER_DAEMON_JSON}；请手动执行: sudo systemctl restart docker"
            else
                info "Docker 守护进程代理已恢复；请手动执行: sudo systemctl restart docker"
            fi
            ;;
        colima)
            if ! write_colima_docker_config "$updated"; then
                warn "无法写入 Colima Docker 守护进程配置；终端代理已保持启用"
                return 0
            fi
            if [[ "$action" == "apply" ]]; then
                info "Colima Docker 守护进程代理已写入；请手动执行: colima restart"
            else
                info "Colima Docker 守护进程代理已恢复；请手动执行: colima restart"
            fi
            ;;
    esac
}

configure_docker_proxy_on() {
    detect_docker_target
    case "$DOCKER_TARGET_KIND" in
        linux)
            configure_docker_target apply "$DOCKER_TARGET_NAME" \
                "http://${HTTP_HOST}:${HTTP_PORT}"
            ;;
        colima)
            configure_docker_target apply "$DOCKER_TARGET_NAME" \
                "http://host.lima.internal:${HTTP_PORT}"
            ;;
        desktop)
            warn "检测到 Docker Desktop；其 daemon.json 代理会被忽略，请在 Docker Desktop 设置中手动配置"
            ;;
    esac
}

configure_docker_proxy_off() {
    detect_docker_target
    case "$DOCKER_TARGET_KIND" in
        linux|colima) configure_docker_target restore "$DOCKER_TARGET_NAME" "" ;;
        desktop) warn "检测到 Docker Desktop；请在 Docker Desktop 设置中手动关闭代理" ;;
    esac
}

docker_proxy_status() {
    detect_docker_target
    case "$DOCKER_TARGET_KIND" in
        linux)
            echo -e "${BOLD}Docker 守护进程代理${RESET}"
            echo "  引擎: Linux Docker"
            echo "  配置: ${DOCKER_DAEMON_JSON}"
            [[ -f "$DOCKER_STATE_FILE" ]] && echo "  setproxy 配置已写入，变更后请执行: sudo systemctl restart docker" \
                || echo "  状态: 未由 setproxy 管理"
            ;;
        colima)
            echo -e "${BOLD}Docker 守护进程代理${RESET}"
            echo "  引擎: Colima (${COLIMA_PROFILE:-default})"
            [[ -f "$DOCKER_STATE_FILE" ]] && echo "  setproxy 配置已写入，变更后请执行: colima restart" \
                || echo "  状态: 未由 setproxy 管理"
            ;;
        desktop)
            echo -e "${BOLD}Docker 守护进程代理${RESET}"
            echo "  引擎: Docker Desktop（请在 Desktop 设置中管理代理）"
            ;;
    esac
}

nc_supports_proxy() {
    command -v nc >/dev/null 2>&1 || return 1
    local help
    help="$(nc -h 2>&1 || true)"
    grep -q -- '-x' <<< "$help" && grep -q -- '-X' <<< "$help"
}

write_proxy_env() {
    mkdir -p "$PROXY_DIR"
    {
        echo "# VPN shell proxy — managed by setproxy"
        printf 'export http_proxy="%s"\n' "http://${HTTP_HOST}:${HTTP_PORT}"
        printf 'export https_proxy="%s"\n' "http://${HTTP_HOST}:${HTTP_PORT}"
        printf 'export HTTP_PROXY="%s"\n' "http://${HTTP_HOST}:${HTTP_PORT}"
        printf 'export HTTPS_PROXY="%s"\n' "http://${HTTP_HOST}:${HTTP_PORT}"
        printf 'export all_proxy="%s"\n' "socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
        printf 'export ALL_PROXY="%s"\n' "socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
        printf 'export no_proxy="%s"\n' "127.0.0.1,localhost,::1"
        printf 'export NO_PROXY="%s"\n' "127.0.0.1,localhost,::1"
        if [[ "$GIT_SSH_PROXY" == "true" ]]; then
            printf 'export GIT_SSH_COMMAND=%q\n' \
                "ssh -o ProxyCommand=\"nc -x ${SOCKS_HOST}:${SOCKS_PORT} -X 5 %h %p\""
        else
            echo "unset GIT_SSH_COMMAND"
        fi
    } > "$PROXY_ENV"
    chmod 600 "$PROXY_ENV"
}

emit_exports() {
    grep -E '^(export|unset) ' "$PROXY_ENV"
}

emit_unsets() {
    echo "unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY no_proxy NO_PROXY GIT_SSH_COMMAND"
}

is_sourced() {
    if [[ -n "${ZSH_EVAL_CONTEXT:-}" && "${ZSH_EVAL_CONTEXT}" == *:file ]]; then
        return 0
    fi
    [[ "${BASH_SOURCE[0]:-}" != "$0" ]]
}

apply_to_current_shell() {
    if is_sourced; then
        # shellcheck disable=SC1090
        . "$PROXY_ENV"
        success "当前 shell 已加载代理环境变量"
    fi
}

clear_current_shell() {
    if is_sourced; then
        unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
        unset all_proxy ALL_PROXY no_proxy NO_PROXY GIT_SSH_COMMAND
    fi
}

log_hint() {
    echo -e "${BOLD}━━━ 查看代理客户端是否正常工作 ━━━${RESET}"
    if $IS_DARWIN; then
        echo "  V2RayXS 进程: pgrep -fl 'V2RayXS|xray'"
        echo "  端口监听    : lsof -nP -iTCP:${HTTP_PORT} -iTCP:${SOCKS_PORT} -sTCP:LISTEN"
        echo "  Xray LaunchAgent: launchctl list | grep com.vpn.xray-client"
        echo "  Xray 日志       : tail -f /tmp/xray-client.log"
    else
        echo "  服务状态 : systemctl status xray-client"
        echo "  最近日志 : journalctl -u xray-client -n 50 --no-pager"
        echo "  实时日志 : journalctl -u xray-client -f"
    fi
}

curl_request() {
    local proxy_arg="$1"
    shift
    if [[ -n "$proxy_arg" ]]; then
        curl -x "$proxy_arg" "$@"
    else
        curl --proxy '' --noproxy '*' "$@"
    fi
}

check_site() {
    local label="$1" proxy_arg="$2" url="$3" tolerate_403="${4:-false}" code
    code="$(curl_request "$proxy_arg" -sSL --connect-timeout 8 --max-time 15 \
        -o /dev/null -w "%{http_code}" "$url" 2>/dev/null)" || code="000"
    if [[ "$code" =~ ^2 ]] || { [[ "$tolerate_403" == "true" ]] && [[ "$code" == "403" ]]; }; then
        echo -e "  ${label} ${GREEN}HTTP ${code}${RESET}"
        return 0
    fi
    echo -e "  ${label} ${RED}HTTP ${code}${RESET}"
    return 1
}

speed_test() {
    local label="$1" proxy_arg="$2" url="$3" range_header="${4:-}"
    local stats code time_total size speed_bps kbps mbps rc=0
    local curl_args=(-sSL --connect-timeout 10 --max-time 30 \
        -o /dev/null -w "%{http_code} %{time_total} %{size_download} %{speed_download}")
    [[ -n "$range_header" ]] && curl_args+=(-H "$range_header")
    # curl 超时(exit 28)也会输出已下载部分的统计，不能丢弃后误报 HTTP 000
    stats="$(curl_request "$proxy_arg" "${curl_args[@]}" "$url" 2>/dev/null)" || rc=$?
    [[ -n "$stats" ]] || stats="000 0 0 0"
    read -r code time_total size speed_bps <<< "$stats"
    if [[ "$code" =~ ^2 ]]; then
        kbps="$(awk -v b="$speed_bps" 'BEGIN{printf "%.0f", b/1024}')"
        mbps="$(awk -v b="$speed_bps" 'BEGIN{printf "%.2f", b*8/1000000}')"
        if [[ "$rc" -eq 0 ]]; then
            echo -e "  ${label} ${GREEN}${kbps} KB/s（约 ${mbps} Mbps，${size} bytes，耗时 ${time_total}s）${RESET}"
            return 0
        fi
        if [[ "$size" =~ ^[0-9]+$ ]] && (( size > 0 )); then
            echo -e "  ${label} ${YELLOW}${kbps} KB/s（约 ${mbps} Mbps，部分下载 ${size} bytes/${time_total}s 后中断，链路降级）${RESET}"
            return 1
        fi
    fi
    echo -e "  ${label} ${RED}下载失败 (HTTP ${code})${RESET}"
    return 1
}

do_on() {
    if ! port_listening "$HTTP_PORT"; then
        warn "HTTP 代理端口 ${HTTP_HOST}:${HTTP_PORT} 未监听，请确认代理客户端已启动"
    fi
    if ! port_listening "$SOCKS_PORT"; then
        warn "SOCKS 代理端口 ${SOCKS_HOST}:${SOCKS_PORT} 未监听，请确认代理客户端已启动"
    fi
    if [[ "$GIT_SSH_PROXY" == "true" ]] && ! nc_supports_proxy; then
        warn "当前 nc 不支持 -x/-X，Git SSH 代理可能不可用；可用 --no-git-ssh 禁用"
    fi

    write_config
    write_proxy_env
    ensure_shell_hook "${HOME}/.bashrc"
    ensure_shell_hook "${HOME}/.zshrc"
    ensure_shell_hook "${HOME}/.profile"
    if $DNF_PROXY; then
        if dnf_available; then
            configure_dnf_proxy_on
        else
            warn "当前系统不支持 dnf 代理配置；终端代理仍会启用"
        fi
    fi
    if $DOCKER_DAEMON; then
        configure_docker_proxy_on
    fi

    if $EMIT; then
        emit_exports
        return 0
    fi

    success "终端代理已开启（新开的终端自动生效）"
    info "HTTP/HTTPS → http://${HTTP_HOST}:${HTTP_PORT}"
    info "ALL_PROXY  → socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
    if [[ "$GIT_SSH_PROXY" == "true" ]]; then
        info "Git SSH    → SOCKS5 ${SOCKS_HOST}:${SOCKS_PORT}（未修改 ~/.ssh/config）"
    else
        info "Git SSH    → 未启用"
    fi
    info "配置文件   → ${PROXY_ENV}"

    apply_to_current_shell
    if ! is_sourced; then
        echo ""
        warn "当前已打开的终端需手动加载一次:"
        echo "  source ${PROXY_ENV}"
        echo "  或: eval \"\$(setproxy on --emit)\""
    fi
}

do_off() {
    rm -f "$PROXY_ENV"
    clear_current_shell
    configure_dnf_proxy_off
    configure_docker_proxy_off

    if $EMIT; then
        emit_unsets
        success "终端代理已关闭"
        return 0
    fi

    success "终端代理已关闭（新开的终端将直连）"
    if ! is_sourced; then
        echo ""
        info "当前已打开的终端请执行:"
        echo "  eval \"\$(setproxy off --emit)\""
    fi
    echo ""
    warn "这只关闭终端环境变量，不会停止代理客户端本身"
}

do_status() {
    echo -e "${BOLD}配置文件${RESET}"
    if [[ -f "$PROXY_ENV" ]]; then
        echo -e "  状态: ${GREEN}已开启${RESET}"
        echo "  环境: ${PROXY_ENV}"
    else
        echo -e "  状态: ${YELLOW}已关闭${RESET}"
    fi
    echo "  参数: ${CONFIG_FILE}"
    echo "  HTTP: http://${HTTP_HOST}:${HTTP_PORT}"
    echo "  SOCKS: socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
    echo "  Git SSH 代理: ${GIT_SSH_PROXY}"

    echo ""
    echo -e "${BOLD}当前 shell 环境变量${RESET}"
    local any=false value variable
    for variable in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY GIT_SSH_COMMAND; do
        eval "value=\${${variable}:-}"
        if [[ -n "$value" ]]; then
            echo "  ${variable}=${value}"
            any=true
        fi
    done
    $any || echo "  （未设置）"

    echo ""
    echo -e "${BOLD}本地代理端口${RESET}"
    if port_listening "$HTTP_PORT"; then
        echo -e "  HTTP  ${HTTP_HOST}:${HTTP_PORT} ${GREEN}监听中${RESET}"
    else
        echo -e "  HTTP  ${HTTP_HOST}:${HTTP_PORT} ${RED}未监听${RESET}"
    fi
    if port_listening "$SOCKS_PORT"; then
        echo -e "  SOCKS ${SOCKS_HOST}:${SOCKS_PORT} ${GREEN}监听中${RESET}"
    else
        echo -e "  SOCKS ${SOCKS_HOST}:${SOCKS_PORT} ${RED}未监听${RESET}"
    fi

    echo ""
    docker_proxy_status
    echo ""
    log_hint
}

do_test() {
    local ok=true
    local http_proxy_arg="http://${HTTP_HOST}:${HTTP_PORT}"
    local socks_proxy_arg="socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
    local size_bytes=$((10#$TEST_SIZE_MB * 1000000))
    local range_end=$((size_bytes - 1))

    echo -e "${BOLD}━━━ 1. 配置与端口 ━━━${RESET}"
    echo "  HTTP 代理 : ${http_proxy_arg}"
    echo "  SOCKS代理 : ${socks_proxy_arg}"
    if port_listening "$HTTP_PORT"; then
        echo -e "  HTTP  端口 ${HTTP_PORT}: ${GREEN}监听中${RESET}"
    else
        echo -e "  HTTP  端口 ${HTTP_PORT}: ${RED}未监听${RESET}"
        ok=false
    fi
    if port_listening "$SOCKS_PORT"; then
        echo -e "  SOCKS 端口 ${SOCKS_PORT}: ${GREEN}监听中${RESET}"
    else
        echo -e "  SOCKS 端口 ${SOCKS_PORT}: ${RED}未监听${RESET}"
        ok=false
    fi

    echo ""
    echo -e "${BOLD}━━━ 2. 常用站点连通性（海外经代理 / 国内强制直连）━━━${RESET}"
    check_site "ipify.org       (HTTP代理) :" "$http_proxy_arg"  "https://api4.ipify.org" false || ok=false
    check_site "google.com      (SOCKS代理):" "$socks_proxy_arg" "https://www.google.com/" false || ok=false
    check_site "github.com      (SOCKS代理):" "$socks_proxy_arg" "https://github.com/" false || ok=false
    check_site "githubusercontent.com(SOCKS):" "$socks_proxy_arg" "https://raw.githubusercontent.com/" false || ok=false
    check_site "docker.io       (SOCKS代理):" "$socks_proxy_arg" "https://docker.io/" false || ok=false
    check_site "claude.ai       (SOCKS代理):" "$socks_proxy_arg" "https://claude.ai/" true || ok=false
    check_site "www.baidu.com   (强制直连) :" "" "https://www.baidu.com/" false || ok=false

    echo ""
    echo -e "${BOLD}━━━ 3. 基准测速（海外经代理 / 国内强制直连）━━━${RESET}"
    speed_test "海外(经代理) Cloudflare ${TEST_SIZE_MB}MB:" "$socks_proxy_arg" \
        "https://speed.cloudflare.com/__down?bytes=${size_bytes}" || ok=false
    speed_test "国内(直连)   清华 TUNA ${TEST_SIZE_MB}MB :" "" \
        "https://mirrors.tuna.tsinghua.edu.cn/archlinux/iso/latest/archlinux-x86_64.iso" \
        "Range: bytes=0-${range_end}" || ok=false

    echo ""
    if $ok; then
        success "代理测试通过"
    else
        error "代理测试未完全通过，请检查代理客户端和路由配置"
        echo ""
        log_hint
        return 1
    fi
}

case "$ACTION" in
    on)     do_on ;;
    off)    do_off ;;
    status) do_status ;;
    test)   do_test ;;
esac
