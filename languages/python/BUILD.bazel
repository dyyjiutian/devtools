load("//tests/common/rules:devtools_tests.bzl", "devtools_e2e_tests", "devtools_host_e2e_tests", "devtools_module_tests")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "python_srcs",
    srcs = [
        "README.md",
        "setup.sh",
    ],
)

exports_files([
    "setup.sh",
    "tests/integration/python_suite.sh",
    "tests/e2e/python_ops_suite.sh",
])

devtools_module_tests(
    name = "python",
    suite = ":tests/integration/python_suite.sh",
    module_root = ":setup.sh",
    module_data = [":python_srcs"],
    profiles = [
        "linux_ubuntu",
        "linux_alinux3",
        "linux_alinux4",
        "macos",
    ],
    docker_profiles = [
        "linux_ubuntu",
        "linux_alinux3",
        "linux_alinux4",
    ],
    tags = [
        "cli",
        "smoke",
    ],
)

devtools_e2e_tests(
    name = "python_ops",
    suite = ":tests/e2e/python_ops_suite.sh",
    module_root = ":setup.sh",
    module_data = [":python_srcs"],
    profiles = [
        "linux_ubuntu",
        "linux_alinux3",
        "linux_alinux4",
    ],
    setup_args = [
        "--skip-pyenv",
        "--skip-ai-packages",
    ],
)

devtools_host_e2e_tests(
    name = "python_ops",
    suite = ":tests/e2e/python_ops_suite.sh",
    module_root = ":setup.sh",
    module_data = [":python_srcs"],
    setup_args = [
        "--skip-pyenv",
        "--skip-ai-packages",
    ],
)
