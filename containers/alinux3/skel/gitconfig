[core]
    autocrlf = input
    whitespace = trailing-space,space-before-tab
    editor = nvim
[pull]
    rebase = true
[rebase]
    autoStash = true
    autoSquash = true
[merge]
    conflictStyle = diff3
[push]
    default = current
    autoSetupRemote = true
    followTags = true
[fetch]
    prune = true
    pruneTags = true
[diff]
    algorithm = histogram
    colorMoved = zebra
[init]
    defaultBranch = main
[rerere]
    enabled = true
