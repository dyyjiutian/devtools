[alias]
  review = "!f() { \
    remote_url=$(git remote get-url origin 2>/dev/null || true); \
    if [ -z \"$remote_url\" ]; then \
      echo \"git review: no 'origin' remote found\" >&2; exit 1; \
    fi; \
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true); \
    if [ -z \"$branch\" ] || [ \"$branch\" = \"HEAD\" ]; then \
      echo \"git review: could not determine current branch\" >&2; exit 1; \
    fi; \
    default_branch=${1:-$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')}; \
    default_branch=${default_branch:-main}; \
    if echo \"$remote_url\" | grep -qi 'github\\.com'; then \
      if ! command -v gh >/dev/null 2>&1; then \
        echo \"git review: 'gh' CLI not found (install: brew install gh)\" >&2; exit 1; \
      fi; \
      echo \"Creating GitHub PR: $branch -> $default_branch\"; \
      git push -u origin HEAD || exit 1; \
      gh pr create --fill --base \"$default_branch\"; \
    elif echo \"$remote_url\" | grep -qi 'gitlab'; then \
      echo \"Creating GitLab MR: $branch -> $default_branch\"; \
      git push -u origin HEAD \
        -o merge_request.create \
        -o \"merge_request.target=$default_branch\" \
        -o merge_request.remove_source_branch; \
    else \
      echo \"Pushing Gerrit review: $branch -> $default_branch\"; \
      git push origin \"HEAD:refs/for/$default_branch\"; \
    fi; \
  }; f"
