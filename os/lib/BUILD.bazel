load("//tests/common/rules:devtools_tests.bzl", "devtools_unit_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "packages_list.sh",
    "dnf_mirrors.sh",
    "repos/epel-8-aliyun.repo",
    "repos/docker-ce-8.repo",
    "repos/docker-ce-8-aliyun.repo",
])

filegroup(
    name = "dnf_mirrors_srcs",
    srcs = [
        "dnf_mirrors.sh",
        "repos/epel-8-aliyun.repo",
        "repos/docker-ce-8.repo",
        "repos/docker-ce-8-aliyun.repo",
    ],
)

devtools_unit_test(
    name = "packages_list_unit_test",
    suite = ":tests/unit/packages_list_suite.sh",
    data = [
        "packages_list.sh",
        "//os/linux:packages.centos.list",
        "//os/linux:packages.ubuntu.list",
        "//os/macos:packages.list",
    ],
    tags = [
        "contract",
        "smoke",
    ],
)

devtools_unit_test(
    name = "dnf_mirrors_unit_test",
    suite = ":tests/unit/dnf_mirrors_suite.sh",
    data = [
        ":dnf_mirrors_srcs",
    ],
    tags = [
        "contract",
        "smoke",
    ],
)
