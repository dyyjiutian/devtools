# Managed by devtools. Aliyun Docker CE companion for Alinux 3 (el8).
# Pin centos/8. Alinux 3 reports VERSION_ID=3, which is not a valid Docker CE tree.
[docker-ce-stable-aliyun]
name=Docker CE Stable Aliyun - $basearch
baseurl=https://mirrors.aliyun.com/docker-ce/linux/centos/8/$basearch/stable
enabled=1
gpgcheck=1
gpgkey=https://mirrors.aliyun.com/docker-ce/linux/centos/gpg
