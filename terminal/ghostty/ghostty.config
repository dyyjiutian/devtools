# Ghostty 终端配置文件
# 配置文档: https://ghostty.org/docs/config

# Shell 集成（与本机其它「双边不一致」项对齐时除外，保留仓库用法）
# 注意：启用 shell-integration 可能导致 SSH 远程连接时命令重复（如 lsls）
# 如需 SSH 无问题，建议设为 none
shell-integration = detect

# === 字体 ===
font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thicken = true
adjust-cell-height = 1

# === 主题与背景 ===
theme = Catppuccin Mocha
background-opacity = 0.7
background-blur = 0

# === 窗口 ===
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-padding-color = background
macos-titlebar-style = hidden

# === 交互 ===
mouse-hide-while-typing = true
link-url = true
scrollback-limit = 10000
cursor-style = bar
cursor-style-blink = false
confirm-close-surface = false

# === tmux 兼容 ===
copy-on-select = false
selection-invert-fg-bg = true

# === 快捷键 ===
keybind = cmd+u=toggle_background_opacity

# Quick Terminal
keybind = global:cmd+opt+t=toggle_quick_terminal
quick-terminal-position = top

# 全局显示/隐藏
keybind = global:cmd+space=toggle_visibility

# tmux 快捷键透传（prefix 可按需改）
keybind = cmd+s=text:\x01\x73
keybind = cmd+b=text:\x01\x7a

# Prompt 跳转
keybind = ctrl+shift+up=jump_to_prompt:-1
keybind = ctrl+shift+down=jump_to_prompt:1
