" ============================================================
" Vim Configuration
" Plugin Manager: vim-plug (auto-install)
" ============================================================

" --- Auto-install vim-plug ---
let data_dir = has('nvim') ? stdpath('data') . '/site' : '~/.vim'
if empty(glob(data_dir . '/autoload/plug.vim'))
  silent execute '!curl -fLo '.data_dir.'/autoload/plug.vim --create-dirs
    \ https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
  autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
endif

" --- Plugins ---
call plug#begin('~/.vim/plugged')

" File tree
Plug 'preservim/nerdtree'
Plug 'ryanoasis/vim-devicons'

" Git
Plug 'tpope/vim-fugitive'
Plug 'airblade/vim-gitgutter'

" Auto-completion (requires Vim 8.1.1719+ or Neovim 0.4.0+)
if has('nvim') || (v:version >= 801 && has('patch1719'))
  Plug 'neoclide/coc.nvim', {'branch': 'release'}
else
  " Fallback: use simpler completion for older Vim
  Plug 'vim-scripts/AutoComplPop'
endif

" Syntax highlighting
Plug 'sheerun/vim-polyglot'

" Tag-based navigation (function jump)
Plug 'preservim/tagbar'
Plug 'ludovicchabant/vim-gutentags'

" Fuzzy finder
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim'

" Status line
Plug 'vim-airline/vim-airline'
Plug 'vim-airline/vim-airline-themes'

" Color scheme
Plug 'morhetz/gruvbox'

" Auto pairs
Plug 'jiangmiao/auto-pairs'

" Comment toggle
Plug 'tpope/vim-commentary'

call plug#end()

" ============================================================
" General Settings
" ============================================================
set nocompatible
filetype plugin indent on
syntax on

set encoding=utf-8
set fileencodings=utf-8,gbk,gb2312,gb18030,latin1
set number
set relativenumber
set cursorline
set showcmd
set showmode
set wildmenu
set wildmode=longest:full,full
set laststatus=2
set scrolloff=5
set sidescrolloff=5
set signcolumn=yes

set clipboard=unnamed,unnamedplus

" 注意：不要使用 set paste，它会禁用代码补全等自动功能
" 使用 F2 键临时切换粘贴模式

" Search
set hlsearch
set incsearch
set ignorecase
set smartcase

" Indent
set autoindent
set smartindent
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab

" Performance
set updatetime=300
set timeoutlen=500
set hidden
set nobackup
set nowritebackup
set noswapfile

" Mouse
set mouse=a

" Cursor shape
let &t_SI = "\e[6 q"   " Insert mode: vertical bar
let &t_SR = "\e[4 q"   " Replace mode: underline
let &t_EI = "\e[2 q"   " Normal mode: block

" Backspace
set backspace=indent,eol,start

" Paste mode - disable auto-indent when pasting
set pastetoggle=<F2>

" Split
set splitbelow
set splitright

" ============================================================
" Color Scheme
" ============================================================
set termguicolors
set background=dark
silent! colorscheme gruvbox

" ============================================================
" Key Mappings
" ============================================================
let mapleader = ","

" NERDTree
nnoremap <Leader>n :NERDTreeToggle<CR>
nnoremap <Leader>f :NERDTreeFind<CR>

" Tagbar
nnoremap <Leader>t :TagbarToggle<CR>

" FZF
nnoremap <Leader>p :Files<CR>
nnoremap <Leader>g :Rg<CR>
nnoremap <Leader>b :Buffers<CR>

" Git (fugitive)
nnoremap <Leader>gs :Git<CR>
nnoremap <Leader>gd :Gdiffsplit<CR>
nnoremap <Leader>gb :Git blame<CR>
nnoremap <Leader>gl :Git log --oneline<CR>

" Window navigation
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Buffer navigation
nnoremap <Leader>bn :bnext<CR>
nnoremap <Leader>bp :bprevious<CR>
nnoremap <Leader>bd :bdelete<CR>

" Clear search highlight
nnoremap <Leader><Space> :nohlsearch<CR>

" Quick save / quit
nnoremap <Leader>w :w<CR>
nnoremap <Leader>q :q<CR>

" ============================================================
" NERDTree Settings
" ============================================================
let g:NERDTreeShowHidden = 1
let g:NERDTreeIgnore = ['\.pyc$', '__pycache__', '\.git$', 'node_modules']
let g:NERDTreeWinSize = 30
" Auto close vim if NERDTree is the only window
autocmd BufEnter * if winnr('$') == 1 && exists('b:NERDTree') && b:NERDTree.isTabTree() | quit | endif

" ============================================================
" coc.nvim Settings (Auto-completion & LSP)
" ============================================================
if has('nvim') || (v:version >= 801 && has('patch1719'))
" Tab to trigger completion and navigate
inoremap <silent><expr> <TAB>
      \ coc#pum#visible() ? coc#pum#next(1) :
      \ CheckBackspace() ? "\<Tab>" :
      \ coc#refresh()
inoremap <expr><S-TAB> coc#pum#visible() ? coc#pum#prev(1) : "\<C-h>"

" Enter to confirm completion
inoremap <silent><expr> <CR> coc#pum#visible() ? coc#pum#confirm()
                              \: "\<C-g>u\<CR>\<c-r>=coc#on_enter()\<CR>"

function! CheckBackspace() abort
  let col = col('.') - 1
  return !col || getline('.')[col - 1]  =~# '\s'
endfunction

" GoTo code navigation
nmap <silent> gd <Plug>(coc-definition)
nmap <silent> gy <Plug>(coc-type-definition)
nmap <silent> gi <Plug>(coc-implementation)
nmap <silent> gr <Plug>(coc-references)

" Show documentation
nnoremap <silent> K :call ShowDocumentation()<CR>
function! ShowDocumentation()
  if CocAction('hasProvider', 'hover')
    call CocActionAsync('doHover')
  else
    call feedkeys('K', 'in')
  endif
endfunction

" Symbol renaming
nmap <Leader>rn <Plug>(coc-rename)

" Diagnostic navigation
nmap <silent> [d <Plug>(coc-diagnostic-prev)
nmap <silent> ]d <Plug>(coc-diagnostic-next)
endif

" ============================================================
" Airline Settings
" ============================================================
let g:airline#extensions#tabline#enabled = 1
let g:airline#extensions#tabline#formatter = 'unique_tail'
let g:airline#extensions#branch#enabled = 1
let g:airline#extensions#hunks#enabled = 1
let g:airline_theme = 'gruvbox'

" ============================================================
" Gutentags Settings (ctags)
" ============================================================
let g:gutentags_project_root = ['.git', '.svn', '.project', 'package.json', 'go.mod', 'pom.xml']
let g:gutentags_ctags_tagfile = '.tags'
let g:gutentags_modules = ['ctags']
let g:gutentags_cache_dir = expand('~/.vim/gutentags')
let g:gutentags_ctags_extra_args = ['--fields=+niazS']

" ============================================================
" Language-specific Settings
" ============================================================
" Python
autocmd FileType python setlocal tabstop=4 shiftwidth=4 softtabstop=4

" Go
autocmd FileType go setlocal tabstop=4 shiftwidth=4 softtabstop=4 noexpandtab

" Java
autocmd FileType java setlocal tabstop=4 shiftwidth=4 softtabstop=4

" Shell
autocmd FileType sh,bash,zsh setlocal tabstop=2 shiftwidth=2 softtabstop=2

" YAML / JSON
autocmd FileType yaml,json setlocal tabstop=2 shiftwidth=2 softtabstop=2

