# Container portability fixture used by module integration tests.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        git \
        coreutils \
        findutils \
        grep \
        sed \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["bash"]
