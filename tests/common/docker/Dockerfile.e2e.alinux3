# Official-image E2E fixture: real dnf, no fake PATH.
FROM alibaba-cloud-linux-3-registry.cn-hangzhou.cr.aliyuncs.com/alinux3/alinux3:latest

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Packages are baked in below. Mask container-inappropriate boot units so
# systemd reaches "running" deterministically instead of stalling in
# "starting" (which fails the compose pair tests):
#   - dnf-makecache re-downloads ~90MB of repo metadata from the slow-from-CI
#     Aliyun mirror on every boot;
#   - serial-getty@getty waits for a /dev/getty device that never appears in a
#     container. Neither is needed by the pair tests (they use docker exec).
# The heavy plus (~45MB metadata) / epel repos are disabled for build and
# runtime: from CI the Aliyun mirror runs ~100kB/s, and editor setups that
# call dnf at runtime otherwise burn the whole 900s test budget on metadata.
# `clean packages` (not `clean all`) keeps the fresh metadata cache so runtime
# installs in the same job reuse it instead of re-downloading.
# kernel-headers is published only under alinux3-plus. COPY the pinned RPM from
# cache/binaries instead of enabling that repo (its metadata is ~45MB and slow
# from CI). glibc-devel then sees the already-installed provide.
COPY kernel-headers-5.10.134-20.2.al8.x86_64.rpm /tmp/kernel-headers.rpm
RUN set -eux; \
    rpm -Uvh --nosignature /tmp/kernel-headers.rpm; \
    rm -f /tmp/kernel-headers.rpm; \
    find /etc/yum.repos.d /etc/yum /etc/dnf -type f \( -name '*.repo' -o -name '*.conf' \) 2>/dev/null \
      | while IFS= read -r repo; do \
          sed -i \
            -e 's|https\?://mirrors\.cloud\.aliyuncs\.com|https://mirrors.aliyun.com|g' \
            -e 's|https\?://mirrors\.aliyuncs\.com|https://mirrors.aliyun.com|g' \
            "$repo"; \
        done; \
    if command -v dnf >/dev/null 2>&1; then PM=dnf; else PM=yum; fi; \
    "$PM" install -y --disablerepo='*plus*' --disablerepo='*epel*' \
        git tar gzip curl sudo zip unzip \
        gcc gcc-c++ make libevent-devel ncurses-devel bison pkgconfig \
        nodejs npm systemd dbus iproute; \
    "$PM" install -y --disablerepo='*plus*' --disablerepo='*epel*' ripgrep || true; \
    for f in /etc/yum.repos.d/*.repo; do \
        sed -i -e '/^\[[^]]*plus[^]]*\]/,/^\[/{s/^enabled *= *1/enabled=0/}' \
               -e '/^\[[^]]*epel[^]]*\]/,/^\[/{s/^enabled *= *1/enabled=0/}' "$f"; \
    done; \
    "$PM" clean packages; \
    ln -sf /dev/null /etc/systemd/system/dnf-makecache.service; \
    ln -sf /dev/null /etc/systemd/system/dnf-makecache.timer; \
    ln -sf /dev/null /etc/systemd/system/serial-getty@getty.service; \
    ln -sf /dev/null /etc/systemd/system/getty@tty1.service; \
    ln -sf /dev/null /etc/systemd/system/getty.target; \
    printf 'ALL ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/e2e; \
    chmod 0440 /etc/sudoers.d/e2e

WORKDIR /workspace
CMD ["bash"]
