# Shared test infrastructure for repository modules.
load("//tests/common/rules:devtools_tests.bzl", "devtools_unit_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "ci/select_layers.sh",
    "lib/run_unit_test.sh",
    "lib/run_module_test.sh",
    "lib/run_e2e_test.sh",
    "docker/run_in_docker.sh",
    "docker/run_e2e_in_docker.sh",
    "docker/run_compose_e2e.sh",
    "docker/compose/vpn-pair.yml",
    "docker/compose/proxy-pair.yml",
])

filegroup(
    name = "run_unit_test",
    srcs = ["lib/run_unit_test.sh"],
)

filegroup(
    name = "run_module_test",
    srcs = ["lib/run_module_test.sh"],
)

filegroup(
    name = "run_in_docker",
    srcs = ["docker/run_in_docker.sh"],
)

filegroup(
    name = "lib_files",
    srcs = glob(["lib/**"]),
)

filegroup(
    name = "docker_files",
    srcs = glob(["docker/**"]),
)

filegroup(
    name = "profiles",
    srcs = glob(["profiles/**"], allow_empty = True),
)

devtools_unit_test(
    name = "docker_runner_unit_test",
    suite = ":tests/unit/docker_runner_suite.sh",
    data = [
        ":docker_files",
    ],
    tags = [
        "contract",
        "smoke",
    ],
)

devtools_unit_test(
    name = "e2e_runner_unit_test",
    suite = ":tests/unit/e2e_runner_suite.sh",
    data = [
        ":docker_files",
    ],
    tags = [
        "contract",
        "smoke",
    ],
)

devtools_unit_test(
    name = "compose_runner_unit_test",
    suite = ":tests/unit/compose_runner_suite.sh",
    data = [
        ":docker_files",
        "//network/vpn:vpn_pair_files",
        "//network/proxy:proxy_pair_files",
        "//tests/common/rules:devtools_tests.bzl",
    ],
    tags = [
        "contract",
        "smoke",
    ],
)

devtools_unit_test(
    name = "select_layers_unit_test",
    suite = ":tests/unit/select_layers_suite.sh",
    data = [
        "ci/select_layers.sh",
    ],
    tags = [
        "contract",
        "smoke",
    ],
)
